#!/usr/bin/env bash
# Run every test suite with this project's bin/ on PATH.
# Usage: ./test            (FAST mode by default — quick, quiet on success)
#        FAST= ./test      (full statistical run)
#        ./test fixed      (run only suites whose name matches 'fixed')
#        SUITE_TIMEOUT=60 ./test   (override the per-suite wall-clock cap)
# Accumulates per-suite failures and returns the count as the exit code.
# NOTE: no `set -e` here on purpose. Suites deliberately exercise non-zero
# exit paths, and errexit would abort the runner on the first one.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$here/bin:$PATH"
export RANDOM_TEST_FILE="$here/tests/random_test"
export FAST="${FAST-1}"
SUITE_TIMEOUT="${SUITE_TIMEOUT:-300}"

filter="${1-}"
failed=0
ran=0

# Required-suite manifest: the glob below is convenient for DISCOVERING
# suites, but a glob only ever reports what's still executable -- it has
# no concept of what SHOULD be there. `chmod -x tests/fixed_test
# tests/kernel_bc_sweep` demonstrated the gap directly: the glob (plus
# `[ -x "$suite" ] || continue` skipping non-executables) silently ran the
# remaining 4 suites and printed "All 4 suite(s) passed", exit 0 -- fewer
# tests ran, but nothing said so. Every suite name this project ships is
# listed here explicitly; missing OR non-executable is now a hard,
# named failure, not a quietly smaller passing count.
REQUIRED_SUITES=(blake3_test drbg_test entropy_backend_test fixed_test golden_test random_test random_jit_diff_test randomz_abi_test randomz_cross_compile_test randomz_test randomz_wasm_test zig_package_test kernel_bc_sweep kernel_jit_diff zig_differential)
missing=0
for name in "${REQUIRED_SUITES[@]}"; do
	suite="$here/tests/$name"
	if [ ! -e "$suite" ]; then
		echo "REQUIRED SUITE MISSING: $name (expected at $suite)" >&2
		missing=$((missing + 1))
	elif [ ! -x "$suite" ]; then
		echo "REQUIRED SUITE NOT EXECUTABLE: $name ($suite) -- chmod +x it" >&2
		missing=$((missing + 1))
	fi
done
if [ "$missing" -gt 0 ] && [ -z "$filter" ]; then
	echo "" >&2
	echo "$missing required suite(s) missing or non-executable -- refusing to report a passing run with fewer suites than expected" >&2
	exit "$missing"
fi

# Every suite runs under `timeout` -- a real, ordinary-arithmetic-reachable
# bug (M.exp's unbounded correction loop before it was bounded; see
# task-7-report.md's fix-up appendix) hung a suite forever with zero
# diagnostic output, which would have hung CI indefinitely rather than
# failing with a message. `timeout` converts that into a fast, loud,
# non-zero-exit failure every time, not just for exp -- any future hang in
# any suite gets the same treatment.
for suite in "$here"/tests/*_test "$here"/tests/kernel_bc_sweep "$here"/tests/kernel_jit_diff "$here"/tests/zig_differential; do
	[ -x "$suite" ] || continue
	name="$(basename "$suite")"
	if [ -n "$filter" ] && [[ "$name" != *"$filter"* ]]; then continue; fi
	ran=$((ran + 1))
	# NOTE: deliberately NOT `if ! timeout ...; then rc=$?`. `!` inverts the
	# exit status bash's `if` sees, and `$?` after entering the `then`
	# branch reflects THAT inverted (already-negated-to-0) status, not
	# timeout's real 124 -- confirmed directly: `if ! timeout 1 sleep 5;
	# then rc=$?; fi` captures rc=0, not 124. Run bare, capture $? first,
	# branch on it after.
	timeout "$SUITE_TIMEOUT" "$suite"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		failed=$((failed + 1))
		if [ "$rc" -eq 124 ]; then
			echo "SUITE TIMED OUT after ${SUITE_TIMEOUT}s: $name" >&2
		else
			echo "SUITE FAILED: $name" >&2
		fi
	fi
done

if [ "$ran" -eq 0 ]; then
	echo "No test suites matched '${filter}'" >&2
	exit 1
fi

if [ "$failed" -gt 0 ]; then
	echo "" >&2
	echo "$failed of $ran suite(s) FAILED" >&2
else
	echo ""
	echo "All $ran suite(s) passed"
fi
exit "$failed"
