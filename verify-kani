#!/usr/bin/env bash
# Opt-in bounded contracts. Never changes the normal Rust environment.
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "${1:-}" != --inside ]; then
	if [ "$#" -ne 0 ]; then echo 'Usage: ./verify-kani' >&2; exit 2; fi
	results=$(mktemp -d "${TMPDIR:-/dev/shm}/random-kani.XXXXXX") || exit 1
	exec nix develop "$root#kani" -c bash "$root/verify-kani" --inside "$results"
fi
if [ "$#" -ne 2 ] || [ ! -d "$2" ]; then exit 2; fi
results=$2
cd "$root" || exit 1
printf 'Kani evidence directory: %s\n' "$results"
# One compiler worker and one sequential solver; 4 GiB virtual memory per process.
ulimit -v 4194304 || exit 1
export CARGO_BUILD_JOBS=1 CARGO_NET_OFFLINE=true
unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS
export CARGO_HOME="$results/cargo-home"
mkdir -p "$CARGO_HOME" || exit 1
ln -s "$RANDOM_KANI_CARGO_CONFIG" "$CARGO_HOME/config.toml" || exit 1
git rev-parse HEAD > "$results/revision.txt" || exit 1
mapfile -t rust_sources < <(rg --files rust/randomr/src | sort)
[ "${#rust_sources[@]}" -gt 0 ] || exit 1
sha256sum flake.nix flake.lock Cargo.toml Cargo.lock rust/randomr/Cargo.toml "${rust_sources[@]}" \
	nix/kani.nix verification/kani/check-result verification/kani/contracts.json \
	verification/kani/contracts.jq tests/kani_gate_test verify-kani > "$results/sources.sha256" || exit 1
ids=$(jq -er '.harnesses[].id' verification/kani/contracts.json) || exit 1
mapfile -t harnesses <<<"$ids"
check_metadata() {
	local target="$1" output="$2"
	local -a metadata
	mapfile -t metadata < <(rg --files --hidden "$target" | rg '\.kani-metadata\.json$')
	[ "${#metadata[@]}" -gt 0 ] || return 1
	jq -s '[.[]|select(.crate_name=="randomr")|.proof_harnesses[]]' "${metadata[@]}" > "$output" || return 1
	bash "$root/verification/kani/check-result" discovery < "$output"
}
for phase in negative positive; do
	if [ "$phase" = negative ]; then export RUSTFLAGS='--cfg kani_negative'; else unset RUSTFLAGS; fi
	# Discover before filtering. Metadata from --harness-selected compilations
	# alone cannot reveal a new, accidentally unlisted proof.
	command time -v -o "$results/$phase-unfiltered.time" timeout --kill-after=5 240 cargo-kani kani \
		--package randomr --lib --no-default-features --only-codegen \
		--target-dir "$results/$phase-unfiltered-target" -Z unstable-options -Z stubbing \
		> "$results/$phase-unfiltered.log" 2>&1
	status=$?
	if [ "$status" -ne 0 ] || ! check_metadata "$results/$phase-unfiltered-target" "$results/$phase-unfiltered-discovery.json"; then
		printf 'Kani %s unfiltered discovery FAILED; inspect %s\n' "$phase" "$results" >&2
		exit 1
	fi
	printf 'Kani %s unfiltered proof manifest accepted\n' "$phase"
	for harness in "${harnesses[@]}"; do
		tag=${harness//::/_}
		limit=$(jq -er --arg id "$harness" '.harnesses[]|select(.id==$id)|.timeout_seconds // 240' verification/kani/contracts.json) || exit 1
		command time -v -o "$results/$phase-$tag.time" timeout --kill-after=5 "$limit" cargo-kani kani \
			--package randomr --lib --no-default-features \
			--target-dir "$results/$phase-target" --harness "$harness" --exact \
			--solver minisat -Z unstable-options -Z stubbing --export-json "$results/$phase-$tag.json" \
			> "$results/$phase-$tag.log" 2>&1
		status=$?
		if [ "$phase" = negative ]; then expected=1; else expected=0; fi
		if [ "$status" -ne "$expected" ] || ! bash "$root/verification/kani/check-result" "$phase" "$harness" < "$results/$phase-$tag.json"; then
			printf 'Kani %s %s gate FAILED (exit %s); inspect %s\n' "$phase" "$harness" "$status" "$results" >&2
			exit 1
		fi
		printf 'Kani %s %s evidence accepted\n' "$phase" "$harness"
	done
	check_metadata "$results/$phase-target" "$results/$phase-discovery.json" || exit 1
	sha256sum --check --status "$results/sources.sha256" || { echo 'Kani sources changed during verification' >&2; exit 1; }
done
printf 'Kani PASSED: %s contracts, named failing controls, reachable covers and compiled-manifest match\n' "${#harnesses[@]}"
