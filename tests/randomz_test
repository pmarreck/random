#!/usr/bin/env bash
# C-FFI CLI acceptance and LuaJIT-oracle differential suite.
# No set -e: failures are accumulated so one run reports the whole matrix.
set -u
set -o pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$here/.."
lua_cli="${ORACLE_CLI:-$root/bin/random}"
c_cli="${RANDOMZ_TEST_CLI:-$root/zig-out/bin/randomz}"
oracle_label="${ORACLE_KIND:-luajit}"
candidate_label="${RANDOM_TEST_CLI_KIND:-zig}"
fails=0
cases=0
tmp="$(mktemp -d "${TMPDIR:-/tmp}/randomz-differential.XXXXXX")" || exit 1
trap 'rm -rf -- "$tmp"' EXIT

# The repository-default target is always rebuilt. Otherwise source edits can
# be "verified" against a stale zig-out executable left by an earlier run.
if [ -z "${RANDOMZ_TEST_CLI:-}" ]; then
	zig build -Doptimize=ReleaseFast >/dev/null || exit 1
fi
if [ ! -x "$lua_cli" ]; then
	echo "randomz test FAILED: oracle CLI is not executable: $lua_cli" >&2
	exit 1
fi
if [ ! -x "$c_cli" ]; then
	echo "randomz test FAILED: C CLI is not executable: $c_cli" >&2
	exit 1
fi

if [ -z "${RANDOMZ_DIFFERENTIAL_ONLY:-}" ]; then
	echo "Testing the shared CLI contract through the selected frontend..."
	RANDOM_TEST_CLI="$c_cli" RANDOM_TEST_CLI_KIND="${RANDOM_TEST_CLI_KIND:-zig}" \
		RANDOM_TEST_DEPTH=0 "$here/random_test"
	rc=$?
	if [ "$rc" -ne 0 ]; then fails=$((fails + 1)); fi

	RANDOM_TEST_CLI="$c_cli" RANDOM_TEST_CLI_KIND="${RANDOM_TEST_CLI_KIND:-zig}" \
		"$here/drbg_test"
	rc=$?
	if [ "$rc" -ne 0 ]; then fails=$((fails + 1)); fi

	if [ -e /dev/full ]; then
	echo "Testing C frontend write failures are reported..."
	for spec in "-b -c 64" "-b --hex -c 64" "-b --base64 -c 64"; do
		read -r -a argv <<<"$spec"
		"$c_cli" -d --seed 42 "${argv[@]}" >/dev/full 2>/dev/null
		if [ "$?" -eq 0 ]; then
			echo "randomz I/O control FAILED: success writing '$spec' to /dev/full" >&2
			fails=$((fails + 1))
		fi
	done
	printf 'alpha\nbeta\n' | "$c_cli" -d --seed 42 --choose >/dev/full 2>/dev/null
	if [ "$?" -eq 0 ]; then
		echo "randomz I/O control FAILED: stdin operation succeeded writing to /dev/full" >&2
		fails=$((fails + 1))
	fi
	"$c_cli" -d -c 1 >/dev/null 2>/dev/full
	if [ "$?" -eq 0 ]; then
		echo "randomz I/O control FAILED: auto-seed succeeded without reporting replay seed" >&2
		fails=$((fails + 1))
	fi
	for output_cli in "$lua_cli" "$c_cli"; do
		for output_spec in '--help' '--about' '--beta --view --utf8'; do
			read -r -a output_argv <<<"$output_spec"
			output_err="$tmp/output-error.$cases"
			cases=$((cases + 1))
			"$output_cli" "${output_argv[@]}" >/dev/full 2>"$output_err"
			if [ "$?" -eq 0 ] || grep -Fq 'panicked at' "$output_err"; then
				echo "frontend I/O control FAILED: $output_cli '$output_spec' did not report /dev/full cleanly" >&2
				fails=$((fails + 1))
			fi
		done
	done
fi

echo "Testing generated distribution help parity and terminal framing..."
if [ -z "${RANDOMZ_SKIP_CHART_SOURCE_CONTROLS:-}" ]; then
	if ! luajit "$root/tools/generate_distribution_charts.lua" --check; then
		fails=$((fails + 1))
	fi
	if command -v sixel2png >/dev/null 2>&1 && command -v magick >/dev/null 2>&1; then
	echo "Checking Sixel charts through the independent libsixel decoder..."
	for chart_name in normal exponential poisson log_normal beta; do
		png="$tmp/$chart_name.png"
		decoded="$tmp/$chart_name-sixel.png"
		if ! env CHART_LIB="$root/lib" CHART_NAME="$chart_name" luajit -e \
			'package.path=os.getenv("CHART_LIB").."/?.lua;"..package.path; io.write(require("distribution_charts")[os.getenv("CHART_NAME")].png_base64)' |
			base64 -d >"$png"; then
			echo "Sixel decode control FAILED: could not extract $chart_name PNG" >&2
			fails=$((fails + 1))
			continue
		fi
		if ! env CHART_LIB="$root/lib" CHART_NAME="$chart_name" luajit -e \
			'package.path=os.getenv("CHART_LIB").."/?.lua;"..package.path; io.write("\27P0;1;0q", require("distribution_charts")[os.getenv("CHART_NAME")].sixel_data, "\27\\")' |
			sixel2png - "$decoded"; then
			echo "Sixel decode control FAILED: libsixel rejected $chart_name" >&2
			fails=$((fails + 1))
			continue
		fi
		if ! magick compare -metric AE -fuzz 1% "$png" "$decoded" null: >/dev/null 2>&1; then
			echo "Sixel decode control FAILED: $chart_name differs from its PNG canvas" >&2
			fails=$((fails + 1))
		fi
		done
	view_rgb="$tmp/beta-view.rgb"
	view_png="$tmp/beta-view.png"
	view_sixel_png="$tmp/beta-view-sixel.png"
	if env VIEW_LIB="$root/lib" luajit -e '
		package.path=os.getenv("VIEW_LIB").."/?.lua;"..package.path
		local f=require("fixed"); local v=require("distribution_view")
		local function p(s) local m,e=f.parse(s); return {m,e} end
		io.write(v.render("beta",p("1"),p("3"),"kitty"))' |
		base64 -d >"$view_rgb" &&
	   magick -size 336x144 -depth 8 "rgb:$view_rgb" "$view_png" &&
	   env VIEW_LIB="$root/lib" luajit -e '
		package.path=os.getenv("VIEW_LIB").."/?.lua;"..package.path
		local f=require("fixed"); local v=require("distribution_view")
		local function p(s) local m,e=f.parse(s); return {m,e} end
		io.write("\27P0;1;0q",v.render("beta",p("1"),p("3"),"sixel"),"\27\\")' |
		sixel2png - "$view_sixel_png" &&
	   magick compare -metric AE -fuzz 1% "$view_png" "$view_sixel_png" null: \
		>/dev/null 2>&1; then
		echo "Parameterized Sixel decode control passed"
	else
		echo "Parameterized Sixel decode control FAILED" >&2
		fails=$((fails + 1))
	fi
  else
		echo "Skipping independent Sixel decode control (libsixel/ImageMagick unavailable)"
	fi
fi

compare_help() {
	local label="$1" expected="$2" requested="$3" tmux_value="$4"
	shift 4
	cases=$((cases + 1))
	local lua_raw="$tmp/help-lua-raw.$cases" c_raw="$tmp/help-c-raw.$cases"
	local lua_out="$tmp/help-lua.$cases" c_out="$tmp/help-c.$cases"
	if [ -n "$tmux_value" ]; then
		env RANDOMZ_CHART_TYPE="$requested" TMUX="$tmux_value" \
			"$lua_cli" "$@" >"$lua_raw"
		env RANDOMZ_CHART_TYPE="$requested" TMUX="$tmux_value" \
			"$c_cli" "$@" >"$c_raw"
	else
		env -u TMUX RANDOMZ_CHART_TYPE="$requested" "$lua_cli" "$@" >"$lua_raw"
		env -u TMUX RANDOMZ_CHART_TYPE="$requested" "$c_cli" "$@" >"$c_raw"
	fi
	# The frontends intentionally advertise different invocation and seed-env
	# names in their generic help. The distribution-qualified block below its
	# marker is the shared byte-for-byte contract under test here.
	sed -n '/^Distribution: /,$p' "$lua_raw" >"$lua_out"
	sed -n '/^Distribution: /,$p' "$c_raw" >"$c_out"
	if ! cmp -s "$lua_out" "$c_out"; then
		echo "randomz help differential FAILED: $label" >&2
		cmp "$lua_out" "$c_out" >&2 || true
		fails=$((fails + 1))
	fi
	if [ "$expected" = "utf8" ]; then
		if ! grep -Fq 'Distribution: ' "$lua_out" ||
		   ! grep -Fq '⡇' "$lua_out" || grep -Fq $'\033_G' "$lua_out" ||
		   grep -Fq $'\033P0;1;0q' "$lua_out"; then
			echo "randomz help framing FAILED: $label did not use UTF-8-only output" >&2
			fails=$((fails + 1))
		fi
	elif [ "$expected" = "sixel" ]; then
		if ! grep -Fq $'\0337\033P0;1;0q"1;1;336;144#0;2;5;6;9' "$lua_out" ||
		   ! grep -Fq $'\033\\\0338' "$lua_out" || grep -Fq $'\033_G' "$lua_out"; then
			echo "randomz help framing FAILED: $label lacks direct Sixel DCS framing" >&2
			fails=$((fails + 1))
		fi
	elif [ -z "$tmux_value" ]; then
		if ! grep -Fq $'\033_Ga=T,f=100,t=d,c=56,r=12,C=1,q=2,m=1;iVBORw0KGgo' "$lua_out"; then
			echo "randomz help framing FAILED: $label lacks a direct PNG Kitty transmission" >&2
			fails=$((fails + 1))
		fi
	else
		if ! grep -Fq $'\033Ptmux;\033\033_Ga=T,f=100,t=d,c=56,r=12,C=1,q=2,m=1;iVBORw0KGgo' "$lua_out" ||
		   ! grep -Fq $'\033\033\\\033\\' "$lua_out"; then
			echo "randomz help framing FAILED: $label lacks tmux passthrough framing" >&2
			fails=$((fails + 1))
		fi
	fi
}

for help_dist in --normalized --exponential --poisson --log-normal --beta; do
	compare_help "UTF-8 $help_dist" utf8 utf8 "" "$help_dist" --help
done
compare_help "direct Kitty PNG" kitty kitty "" --help --normalized
compare_help "tmux-wrapped Kitty PNG" kitty kitty fake --normalized --help
compare_help "direct Sixel" sixel sixel "" --normalized --help
compare_help "--utf8-graphics overrides env" utf8 kitty "" --normalized --utf8-graphics --help
compare_help "--kitty overrides env" kitty utf8 "" --help --kitty --normalized
compare_help "--sixel overrides env" sixel utf8 "" --sixel --normalized --help

compare_view() {
	local label="$1" expected="$2" requested="$3" tmux_value="$4"
	shift 4
	cases=$((cases + 1))
	local lua_out="$tmp/view-lua.$cases" c_out="$tmp/view-c.$cases"
	local lua_err="$tmp/view-lua.$cases.err" c_err="$tmp/view-c.$cases.err"
	if [ -n "$tmux_value" ]; then
		env RANDOMZ_CHART_TYPE="$requested" TMUX="$tmux_value" \
			"$lua_cli" "$@" >"$lua_out" 2>"$lua_err"
		env RANDOMZ_CHART_TYPE="$requested" TMUX="$tmux_value" \
			"$c_cli" "$@" >"$c_out" 2>"$c_err"
	else
		env -u TMUX RANDOMZ_CHART_TYPE="$requested" \
			"$lua_cli" "$@" >"$lua_out" 2>"$lua_err"
		env -u TMUX RANDOMZ_CHART_TYPE="$requested" \
			"$c_cli" "$@" >"$c_out" 2>"$c_err"
	fi
	if [ -s "$lua_err" ] || [ -s "$c_err" ] || ! cmp -s "$lua_out" "$c_out"; then
		echo "randomz view differential FAILED: $label" >&2
		cmp "$lua_out" "$c_out" >&2 || true
		fails=$((fails + 1))
	fi
	if ! grep -q '^Distribution: ' "$lua_out" || grep -q '^Usage: ' "$lua_out"; then
		echo "randomz view contract FAILED: $label included the wrong prose" >&2
		fails=$((fails + 1))
	fi
	if [ "$expected" = "utf8" ]; then
		if ! grep -Fq '⡇' "$lua_out" || grep -Fq $'\033_G' "$lua_out" ||
		   grep -Fq $'\033P0;1;0q' "$lua_out"; then
			echo "randomz view framing FAILED: $label did not use UTF-8-only output" >&2
			fails=$((fails + 1))
		fi
	elif [ "$expected" = "sixel" ]; then
		if ! grep -Fq $'\0337\033P0;1;0q"1;1;336;144#0;2;5;6;9' "$lua_out" ||
		   ! grep -Fq $'\033\\\0338' "$lua_out"; then
			echo "randomz view framing FAILED: $label lacks Sixel framing" >&2
			fails=$((fails + 1))
		fi
	elif [ -z "$tmux_value" ]; then
		if ! grep -Fq $'\033_Ga=T,f=24,s=336,v=144,c=56,r=12,C=1,q=2,m=1;' "$lua_out"; then
			echo "randomz view framing FAILED: $label lacks direct raw-RGB Kitty framing" >&2
			fails=$((fails + 1))
		fi
	else
		if ! grep -Fq $'\033Ptmux;\033\033_Ga=T,f=24,s=336,v=144,c=56,r=12,C=1,q=2,m=1;' "$lua_out"; then
			echo "randomz view framing FAILED: $label lacks forced tmux Kitty framing" >&2
			fails=$((fails + 1))
		fi
	fi
}

compare_view "normal mean-only" utf8 utf8 "" --normalized --mean=3 --view
compare_view "exponential rate" utf8 utf8 "" --exponential --rate=2.5 --view
compare_view "compressed Poisson lambda" utf8 utf8 "" --poisson --lambda=1000 --view
compare_view "log-normal parameters" utf8 utf8 "" --log-normal --mean=-0.25 --stddev=1.75 --view
compare_view "beta user example" utf8 utf8 "" --beta=3 --alpha=1 --view
compare_view "beta reordered with UTF-8 alias" utf8 utf8 "" --alpha 1 --beta 4 --view --utf8
compare_view "dynamic Kitty" kitty kitty "" --beta=3 --alpha=1 --view
compare_view "dynamic Sixel" sixel sixel "" --beta=3 --alpha=1 --view
compare_view "view UTF-8 flag overrides env" utf8 kitty "" --beta --view --utf8-graphics
compare_view "view Kitty flag overrides env" kitty utf8 "" --beta --kitty --view
compare_view "view Sixel flag overrides env" sixel utf8 "" --sixel --beta --view
compare_view "forced view Kitty through tmux" kitty utf8 fake --beta --kitty --view

for cli in "$lua_cli" "$c_cli"; do
	env RANDOMZ_CHART_TYPE=utf8 "$cli" --beta=3 --alpha=1 --view \
		>"$tmp/view-equals"
	env RANDOMZ_CHART_TYPE=utf8 "$cli" --beta 3 --alpha 1 --view \
		>"$tmp/view-spaces"
	if ! cmp -s "$tmp/view-equals" "$tmp/view-spaces"; then
		echo "randomz view syntax FAILED: $cli differs between --option=value and --option value" >&2
		fails=$((fails + 1))
	fi
done

fi # full selected-frontend acceptance

compare_args() {
	local label="$1"
	shift
	cases=$((cases + 1))
	local lua_out="$tmp/lua.$cases" c_out="$tmp/c.$cases"
	local lua_err="$tmp/lua.$cases.err" c_err="$tmp/c.$cases.err"
	"$lua_cli" "$@" >"$lua_out" 2>"$lua_err"
	local lua_rc=$?
	"$c_cli" "$@" >"$c_out" 2>"$c_err"
	local c_rc=$?
	if [ "$lua_rc" -ne 0 ] || [ "$c_rc" -ne 0 ] || \
	   [ ! -s "$lua_out" ] || [ ! -s "$c_out" ] || ! cmp -s "$lua_out" "$c_out"; then
		echo "frontend differential FAILED: $label ($oracle_label=$lua_rc $candidate_label=$c_rc; bytes=$(wc -c <"$lua_out")/$(wc -c <"$c_out"))" >&2
		echo "  args: $*" >&2
		diff -u <(xxd -p -c 32 <"$lua_out") <(xxd -p -c 32 <"$c_out") >&2 || true
		if [ "$lua_rc" -ne 0 ]; then sed "s/^/  $oracle_label stderr: /" <"$lua_err" >&2; fi
		if [ "$c_rc" -ne 0 ]; then sed "s/^/  $candidate_label stderr: /" <"$c_err" >&2; fi
		fails=$((fails + 1))
	fi
}

compare_failure() {
	local label="$1"
	shift
	cases=$((cases + 1))
	local lua_out="$tmp/fail-lua.$cases" c_out="$tmp/fail-c.$cases"
	local lua_err="$tmp/fail-lua.$cases.err" c_err="$tmp/fail-c.$cases.err"
	"$lua_cli" "$@" >"$lua_out" 2>"$lua_err"
	local lua_rc=$?
	"$c_cli" "$@" >"$c_out" 2>"$c_err"
	local c_rc=$?
	if [ "$lua_rc" -eq 0 ] || [ "$c_rc" -eq 0 ] || [ "$lua_rc" -ne "$c_rc" ] ||
	   ! cmp -s "$lua_out" "$c_out" || ! cmp -s "$lua_err" "$c_err"; then
		echo "frontend failure differential FAILED: $label ($oracle_label=$lua_rc $candidate_label=$c_rc)" >&2
		echo "  args: $*" >&2
		diff -u "$lua_err" "$c_err" >&2 || true
		fails=$((fails + 1))
	fi
}

compare_stdin() {
	local label="$1"
	local input="$2"
	shift 2
	cases=$((cases + 1))
	local lua_out c_out lua_rc c_rc
	lua_out="$(printf '%s' "$input" | "$lua_cli" "$@" 2>/dev/null)"
	lua_rc=$?
	c_out="$(printf '%s' "$input" | "$c_cli" "$@" 2>/dev/null)"
	c_rc=$?
	if [ "$lua_rc" -ne 0 ] || [ "$c_rc" -ne 0 ] || [ "$lua_out" != "$c_out" ]; then
		echo "frontend stdin differential FAILED: $label ($oracle_label=$lua_rc $candidate_label=$c_rc)" >&2
		printf '  %s: %q\n  %s: %q\n' "$oracle_label" "$lua_out" "$candidate_label" "$c_out" >&2
		fails=$((fails + 1))
	fi
}

echo "Testing exact $oracle_label-vs-$candidate_label output over the seed/flag matrix..."
compare_failure "legacy lone endpoint" 10
compare_failure "legacy endpoint pair" 10 20
compare_failure "empty exclusive range" 1...1
compare_failure "range on beta" --beta 3 0..9
compare_failure "range on custom normal" --normalized --mean 5 0..9
compare_failure "nonpositive beta parameter" --beta=0
compare_failure "removed beta-param spelling" --beta-param 3
compare_failure "unknown long option" --heop
compare_failure "negative fractional precision" --exponential --precision -1
compare_failure "excess fractional precision" --exponential --precision=19
compare_failure "fractional precision" --exponential --truncate 1.5
compare_failure "precision does not apply to binary" --exponential -b --precision 6
max_seed=0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
for seed in 0 1 42 "$max_seed"; do
	compare_args "raw XOF boundaries, seed=$seed" -d --seed "$seed" -b -c 131
	compare_args "raw XOF hex, seed=$seed" -d --seed "$seed" -b --hex -c 65
	compare_args "raw XOF base64, seed=$seed" -d --seed "$seed" -b --base64 -c 65
	compare_args "narrow hyphen range, seed=$seed" -d --seed "$seed" -c 32 -17-981
	compare_args "wide dot range, seed=$seed" -d --seed "$seed" -c 32 -4000000000..4000000000
	compare_args "power-of-two wide range, seed=$seed" -d --seed "$seed" -c 32 0..1099511627775
	compare_args "normal exclusive range, seed=$seed" -d --seed "$seed" -n -c 32 -18...1
	compare_args "normal fixed, seed=$seed" -d --seed "$seed" -n --mean -7.25 --stddev 2.5 -c 32
	compare_args "normal mean-only default stddev, seed=$seed" -d --seed "$seed" -n --mean=5 -c 32
	compare_args "normal stddev-only default mean, seed=$seed" -d --seed "$seed" -n --stddev=2 -c 32
	compare_args "exponential, seed=$seed" -d --seed "$seed" --exponential -c 32
	compare_args "exponential custom rate, seed=$seed" -d --seed "$seed" --exponential --rate=4 -c 32
	compare_args "poisson, seed=$seed" -d --seed "$seed" --poisson --mean 5.5 -c 32
	compare_args "poisson lambda alias, seed=$seed" -d --seed "$seed" --poisson --lambda=5.5 -c 32
	compare_args "log-normal, seed=$seed" -d --seed "$seed" --log-normal --mean -0.25 --stddev 1.75 -c 32
	compare_args "beta, seed=$seed" -d --seed "$seed" --beta 7.75 --alpha 2.5 -c 32
	compare_args "beta alpha below one, seed=$seed" -d --seed "$seed" --beta 2 --alpha 0.5 -c 32
	compare_args "beta both below one, seed=$seed" -d --seed "$seed" --beta 0.75 --alpha 0.5 -c 32
	compare_args "ranged binary, seed=$seed" -d --seed "$seed" -b --hex -c 65 64-192
	compare_args "normal binary, seed=$seed" -d --seed "$seed" -b --hex -n -c 65 0...256
	compare_args "exponential binary, seed=$seed" -d --seed "$seed" -b --hex --exponential -c 65
	compare_args "poisson binary, seed=$seed" -d --seed "$seed" -b --hex --poisson --mean 5 -c 65
	compare_args "log-normal binary, seed=$seed" -d --seed "$seed" -b --hex --log-normal -c 65
	compare_args "beta binary, seed=$seed" -d --seed "$seed" -b --hex --beta 5 --alpha 2 -c 65
	compare_args "delimiter, seed=$seed" -d --seed "$seed" --delimiter '::' -c 17 0..100
done
compare_args "maximum fractional precision" -d --seed 42 --exponential -c 8
compare_args "explicit six-place truncation" -d --seed 42 --exponential --precision=6 -c 8
compare_args "truncate alias" -d --seed 42 --exponential --truncate 6 -c 8
compare_args "integer truncation" -d --seed 42 --exponential --precision 0 -c 8
for boundary_count in 65535 65536 65537 65538; do
	compare_args "raw streaming chunk boundary, count=$boundary_count" \
		-d --seed 42 -b -c "$boundary_count"
	compare_args "hex streaming chunk boundary, count=$boundary_count" \
		-d --seed 42 -b --hex -c "$boundary_count"
	compare_args "base64 streaming chunk boundary, count=$boundary_count" \
		-d --seed 42 -b --base64 -c "$boundary_count"
done

stdin_lines=$'alpha\nbeta\ngamma\ndelta\nepsilon\n'
stdin_csv='alpha,beta,gamma,delta,epsilon'
stdin_weighted=$'rare:1\ncommon:10\nverycommon:100\n'
for seed in 1 42 "$max_seed"; do
	compare_stdin "choose, seed=$seed" "$stdin_lines" --choose -d --seed "$seed"
	compare_stdin "choose delimiter, seed=$seed" "$stdin_csv" --choose --delimiter , -d --seed "$seed"
	compare_stdin "shuffle, seed=$seed" "$stdin_lines" --shuffle -d --seed "$seed"
	compare_stdin "weighted, seed=$seed" "$stdin_weighted" --weighted -d --seed "$seed"
done
compare_stdin "CRLF item normalization" $'alpha\r\nbeta\r\ngamma\r\n' --shuffle -d --seed 42

if [ "$fails" -ne 0 ]; then
	echo "frontend test FAILED: $fails control(s) failed across $cases cases ($oracle_label vs $candidate_label)" >&2
	exit "$fails"
fi

echo "frontend test PASSED: shared contract + $cases cases ($oracle_label vs $candidate_label)"
