#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/product_paths.sh"
# Lean frontend acceptance against the shared CLI oracle.
set -u
set -o pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lean_cli="${RANDOML_TEST_CLI:-$RANDOM_TEST_LEAN_OUT/bin/randoml}"
zig_cli="${RANDOML_TEST_ZIG_CLI:-$RANDOM_TEST_ZIG_OUT/bin/randomz}"

if [ -z "${RANDOML_TEST_CLI:-}" ]; then
	build_log=$("$root/lean/build-owned-cli" "$lean_cli" 2>&1)
	build_status=$?
	printf '%s\n' "$build_log"
	[ "$build_status" -eq 0 ] || exit 1
	if grep -q 'warning:' <<<"$build_log"; then
		echo "randoml test RED: production CLI build emitted a compiler warning" >&2
		exit 1
	fi
fi
if [ -z "${RANDOML_TEST_ZIG_CLI:-}" ]; then
	(cd "$root" && zig build --prefix "$RANDOM_TEST_ZIG_OUT" -Doptimize=ReleaseFast) || exit 1
fi
if [ ! -x "$lean_cli" ] || [ ! -x "$zig_cli" ]; then
	echo "randoml test RED: Lean frontend or Zig backend is absent" >&2
	exit 1
fi

CANDIDATE_CLI="$lean_cli" CANDIDATE_KIND=lean ORACLE_CLI="$root/luajit/random" \
	"$root/tests/frontend_differential" || exit 1

lean_sixel=$(env -u TMUX "$lean_cli" --normalized --view --sixel 2>/dev/null | sha256sum | cut -d' ' -f1)
zig_sixel=$(env -u TMUX "$zig_cli" --normalized --view --sixel 2>/dev/null | sha256sum | cut -d' ' -f1)
sixel_hex=$(env -u TMUX "$lean_cli" --normalized --view --sixel 2>/dev/null | xxd -p -c 1048576)
lean_kitty=$(env -u TMUX "$lean_cli" --normalized --view --kitty 2>/dev/null | sha256sum | cut -d' ' -f1)
zig_kitty=$(env -u TMUX "$zig_cli" --normalized --view --kitty 2>/dev/null | sha256sum | cut -d' ' -f1)
if [ "$lean_sixel" != "$zig_sixel" ] || [ "$lean_kitty" != "$zig_kitty" ] ||
   [[ "$sixel_hex" != *'1b371b50'* ]] || [[ "$sixel_hex" != *'1b38'* ]]; then
	echo "randoml compiled chart codec regression: sixel=$lean_sixel/$zig_sixel kitty=$lean_kitty/$zig_kitty" >&2
	exit 1
fi

echo "randoml compiled chart codecs PASSED: layer output matches Zig and ESC framing is byte-exact"
