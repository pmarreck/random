#!/usr/bin/env bash
# Public LuaJIT library imports and exact differential oracles, without payload files.
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LUA_PATH="${RANDOM_LUA_LIBRARY_PATH:-$root/lib}/?.lua;;"
luajit "$root/tests/luajit_library.lua" || exit 1
rust_target=$(cd "$root" && cargo metadata --no-deps --format-version 1 | jq -er .target_directory) || exit 1
rust_cli="$rust_target/release/randomr"
clis=("$root/bin/random" "$root/zig-out/bin/randomz" "$rust_cli" "$root/zig-out/bin/randoml")
for cli in "${clis[@]}"; do
	if [ ! -x "$cli" ]; then
		printf 'LuaJIT library oracle is not executable: %s (build the frontends first)\n' "$cli" >&2
		exit 1
	fi
done
# The module and CLI must share algorithms and continuation byte positions.
for spec in 'range 0 99' 'range 0 4294967296' 'normal_int -10 10' \
	'normal 2 3' 'exponential 2' 'poisson 7' 'log_normal 1 2' 'beta 1 3'; do
	read -r -a params <<<"$spec"
	actual=$(luajit "$root/tests/luajit_library.lua" --samples "${params[@]}") || exit 1
	actual_pos=$(luajit "$root/tests/luajit_library.lua" --samples-pos "${params[@]}") || exit 1
	case "${params[0]}" in
		range) flags=("${params[1]}..${params[2]}");;
		normal_int) flags=(--normalized "${params[1]}..${params[2]}");;
		normal) flags=(--normalized --mean "${params[1]}" --stddev "${params[2]}");;
		exponential) flags=(--exponential --rate "${params[1]}");;
		poisson) flags=(--poisson --lambda "${params[1]}");;
		log_normal) flags=(--log-normal --mean "${params[1]}" --stddev "${params[2]}");;
		beta) flags=(--beta "${params[2]}" --alpha "${params[1]}");;
	esac
	for cli in "${clis[@]}"; do
		expected=$("$cli" --seed 42 --count 8 "${flags[@]}" 2>/dev/null) || exit 1
		if [ "$actual" != "$expected" ]; then
			printf 'LuaJIT library parity FAILED: %s via %s\n' "$spec" "$cli" >&2
			exit 1
		fi
		state=$("$cli" --seed 42 --count 8 "${flags[@]}" 2>&1 >/dev/null) || exit 1
		expected_pos=$(jq -er .next_pos <<<"$state") || exit 1
		if [ "$actual_pos" != "$expected_pos" ]; then
			printf 'LuaJIT library cursor FAILED: %s via %s\n' "$spec" "$cli" >&2
			exit 1
		fi
	done
done
echo 'LuaJIT library PASSED: independent instances, state bounds and four-way sampler parity'
