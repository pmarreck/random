#!/usr/bin/env bash
# Sweeps the integer-only numeric kernel's div and ln against `bc -l`
# (arbitrary precision) as an independent oracle -- see kernel_bc_sweep.lua
# for why a Lua-double comparison cannot validate this kernel's precision
# claim at all.
# NOTE: no `set -e` -- see ./test.
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# A silently-skipped control is worse than no control: it would let the
# kernel's precision claim go unverified forever if bc ever went missing
# from PATH (dev shell or CI) without anyone noticing. Fail loudly instead.
if ! command -v bc >/dev/null 2>&1; then
	echo "kernel_bc_sweep: FAILED -- bc not found on PATH (this control needs it as an independent arbitrary-precision oracle; see flake.nix's testTools)" >&2
	exit 1
fi

exec luajit "$here/kernel_bc_sweep.lua"
