#!/usr/bin/env bash
# Independent Roc kernel gate; CLI acceptance remains tests/random_test,
# unchanged for every language. Oracle values travel through pipes, not files.
set -u
set -o pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root" || exit 1
if [ "$(uname -s)" != Linux ]; then
	echo "Roc core bootstrap: not applicable; the pinned upstream compiler supports Linux packaging only."
	exit 0
fi
if [ -z "${RANDOM_ROC_COMPILER:-}" ]; then
	echo "Roc core test RED: use nix develop, or explicitly provide RANDOM_ROC_COMPILER from .#roc-toolchain" >&2
	exit 1
fi
roc_compiler="$RANDOM_ROC_COMPILER"
roc_kernel="${RANDOM_ROC_CORE_TEST:-$root/zig-out/bin/roc-core-test}"

"$roc_compiler" check roc/test.roc || exit 1
"$roc_compiler" test roc/test.roc || exit 1
if [ -z "${RANDOM_ROC_CORE_TEST:-}" ]; then
	mkdir -p "$(dirname "$roc_kernel")" || exit 1
	"$roc_compiler" build roc/test.roc --opt=speed --output="$roc_kernel" || exit 1
fi
if [ ! -x "$roc_kernel" ]; then
	echo "Roc core test RED: no executable kernel" >&2
	exit 1
fi

oracle_cases="$(luajit - <<'LUA'
local f = require('lib.fixed')
local function integer(n) return (tostring(n):gsub('LL$', '')) end
local function emit(op, m, e, bm, be)
	local result_m, result_e
	if bm then result_m, result_e = f[op](m, e, bm, be)
	else result_m, result_e = f[op](m, e) end
	local argv = op == 'cos_turns' and 'cos' or op
	argv = argv .. ' ' .. integer(m) .. ' ' .. e
	if bm then argv = argv .. ' ' .. integer(bm) .. ' ' .. be end
	print(argv .. '\t' .. integer(result_m) .. ',' .. result_e)
end
-- A structural corpus, not outputs cherry-picked for agreement. Include
-- odd mantissas, sign changes, cancellation and normalization boundaries.
local mantissas = {0x4000000000000000LL, 0x4000000000000001LL,
	0x6000000000000003LL, 0x7fffffffffffffffLL}
local exponents = {-30, -3, -1, 0, 1, 3, 20}
for _, m in ipairs(mantissas) do
	for _, e in ipairs(exponents) do
		emit('ln', m, e)
		emit('sqrt', m, e)
		emit('cos_turns', m, e)
		emit('cos_turns', -m, e)
		if e <= 3 then emit('exp', m, e); emit('exp', -m, e) end
		for _, bm in ipairs(mantissas) do
			for _, sign in ipairs({1LL, -1LL}) do
				for _, op in ipairs({'add', 'sub', 'mul', 'div'}) do
					emit(op, m, e, sign * bm, 1)
				end
			end
		end
	end
	for exponent = -3, 3 do
		local bm, be = f.from_int(exponent)
		emit('pow', m, 1, bm, be)
	end
end
LUA
)" || exit 1
checks=0
while IFS=$'\t' read -r arguments expected; do
	read -r -a argv <<<"$arguments"
	actual="$("$roc_kernel" "${argv[@]}")"
	status=$?
	if [ "$status" -ne 0 ] || [ "$actual" != "$expected" ]; then
		echo "Roc core test FAILED: $arguments => '$actual' (status $status), expected '$expected'" >&2
		exit 1
	fi
	checks=$((checks + 1))
done <<<"$oracle_cases"
if [ "$checks" -lt 1000 ]; then
	echo "Roc core test FAILED: incomplete runtime corpus ($checks)" >&2
	exit 1
fi

for bad in \
	'ln 0 0' 'sqrt -4611686018427387904 0' 'div 4611686018427387904 0 0 0' \
	'ln 1 0' 'ln 0 1' 'ln 4611686018427387904 2147483648' \
	'mul 4611686018427387904 2147483647 4611686018427387904 1' \
	'pow 0 0 4611686018427387904 0' 'unknown 4611686018427387904 0'; do
	read -r -a argv <<<"$bad"
	if "$roc_kernel" "${argv[@]}" >/dev/null 2>&1; then
		echo "Roc core test FAILED: accepted invalid input '$bad'" >&2
		exit 1
	fi
done
printf 'Roc native fixed kernel: %s runtime oracle cases and 9 rejection controls passed.\n' "$checks"

fixture="$root/tests/fixtures/blake3-test-vectors.json"
fixture_hash="$(sha256sum "$fixture" | awk '{print $1}')"
if [ "$fixture_hash" != dcb91ea8accc77e6d6e632af7cdc1a99a9f3ae78cf648da595c7d064db32f624 ]; then
	echo "Roc core test FAILED: official BLAKE3 fixture changed" >&2
	exit 1
fi
vector_checks=0
while IFS=$'\t' read -r length expected_hash expected_derive; do
	input=""
	for ((i=0; i<length; i++)); do
		printf -v byte '%02x' "$((i % 251))"
		input+="$byte"
	done
	actual_hash="$("$roc_kernel" hash "$input")" || exit 1
	actual_derive="$("$roc_kernel" derive 'BLAKE3 2019-12-27 16:29:52 test vectors context' "$input")" || exit 1
	if [ "$actual_hash" != "$expected_hash" ] || [ "$actual_derive" != "$expected_derive" ]; then
		echo "Roc core test FAILED: official hash/derive vector at length $length" >&2
		exit 1
	fi
	vector_checks=$((vector_checks + 2))
done < <(jq -r '.cases[] | select(.input_len<=64) | [.input_len, .hash[0:64], .derive_key[0:64]] | @tsv' "$fixture")
key=77686174732074686520456c7669736820776f726420666f7220667269656e64
expected_xof="$(jq -r '.cases[] | select(.input_len==0) | .keyed_hash' "$fixture")"
for position in 0 1 31 32 63 64 65 127 131; do
	count=$((131 - position))
	actual="$("$roc_kernel" xof "$key" "$position" "$count")" || exit 1
	if [ "$actual" != "${expected_xof:position*2:count*2}" ]; then
		echo "Roc core test FAILED: official keyed XOF vector at position $position" >&2
		exit 1
	fi
	vector_checks=$((vector_checks + 1))
done
if [ "$vector_checks" -ne 31 ]; then
	echo "Roc core test FAILED: incomplete official vectors ($vector_checks)" >&2
	exit 1
fi
printf 'Roc native BLAKE3 subset: %s frozen official vectors passed.\n' "$vector_checks"

drbg_checks=0
for seed in 0 1 42 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff; do
	expected="$(bin/random -d --seed "$seed" -b --hex -c 197 2>/dev/null)" || exit 1
	for position in 0 1 31 32 63 64 65 127 128 131 196 197; do
		count=$((197 - position))
		actual="$("$roc_kernel" drbg "$seed" "$position" "$count")" || exit 1
		if [ "$actual" != "${expected:position*2:count*2}" ]; then
			echo "Roc core test FAILED: DRBG seek at seed $seed position $position" >&2
			exit 1
		fi
		drbg_checks=$((drbg_checks + 1))
	done
done
printf 'Roc native DRBG: %s cross-implementation seek cases passed.\n' "$drbg_checks"

sampler_checks=0
for seed in 0 1 17 42 254; do
	for distribution in normal exponential log_normal beta; do
		expected="$(luajit - "$distribution" "$seed" <<'LUA'
package.path = './lib/?.lua;' .. package.path
local d, f = require('drbg'), require('fixed')
local rng = d.new(string.rep('\0',31) .. string.char(tonumber(arg[2])))
local method, m, e, bm, be = arg[1]
if method == 'normal' or method == 'log_normal' then
	m, e = f.from_int(0); bm, be = f.from_int(1)
elseif method == 'beta' then
	m, e = f.from_int(2); bm, be = f.from_int(2)
else m, e = f.from_int(1) end
for _=1,50 do
	local rm, re
	if bm then rm, re = rng[method](rng, m, e, bm, be)
	else rm, re = rng[method](rng, m, e) end
	print((tostring(rm):gsub('LL$','')) .. ',' .. re)
end
print('pos=' .. rng:position())
LUA
)" || exit 1
		actual="$("$roc_kernel" sample "$distribution" "$seed" 50)" || exit 1
		if [ "$actual" != "$expected" ]; then
			echo "Roc core test FAILED: $distribution seed $seed value/consumption sequence" >&2
			diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2
			exit 1
		fi
		sampler_checks=$((sampler_checks + 50))
	done
done
printf 'Roc native samplers: %s exact mantissa/exponent values and their cursor positions passed.\n' "$sampler_checks"

geometric_cases="$(luajit - <<'LUA'
package.path = './lib/?.lua;' .. package.path
local d, g, c, b = require('drbg'), require('geometric'), require('unsigned_count'), require('blake3')
local probabilities = {
	{0x4000000000000000LL,0}, {0x4000000000000000LL,-1},
	{0x4000000000000000LL,-2}, {0x4000000000000001LL,-62},
	{0x7fffffffffffffffLL,-2}, {0x4000000000000000LL,-100},
	{0x4000000000000000LL,-1000}, {0x4000000000000000LL,-1000000},
}
for _, seed in ipairs({0,42,254}) do
	for _, p in ipairs(probabilities) do
		local rng = d.new(string.rep('\0',31) .. string.char(seed))
		local count = p[2] == -1000000 and 1 or 20
		local values = {}
		for _=1,count do values[#values+1] = b.bin_to_hex(c.to_blip(rng:geometric(p[1],p[2]))) end
		values[#values+1] = 'pos=' .. rng:position()
		print(seed .. ' ' .. (tostring(p[1]):gsub('LL$','')) .. ' ' .. p[2] .. ' ' .. count .. '\t' .. table.concat(values,'|'))
	end
end
LUA
)" || exit 1
geometric_checks=0
while IFS=$'\t' read -r arguments expected; do
	read -r -a argv <<<"$arguments"
	actual="$("$roc_kernel" geometric "${argv[@]}")" || exit 1
	actual="${actual//$'\n'/|}"
	if [ "$actual" != "$expected" ]; then
		echo "Roc core test FAILED: geometric $arguments BLIP values/cursor mismatch" >&2
		exit 1
	fi
	geometric_checks=$((geometric_checks + argv[3]))
done <<<"$geometric_cases"
printf 'Roc native geometric: %s exact BLIP samples and cursor positions passed, including minimum exponent.\n' "$geometric_checks"

integer_checks=0
for seed in 0 42 254; do
	for spec in 'range 1 20' 'range -50 50' 'range 0 4294967296' \
		'range -2 9007199254740988' 'normal_int 1 20' 'normal_int -50 50' 'poisson 1 0' 'poisson 20 0'; do
		read -r -a argv <<<"$spec"
		expected="$(luajit - "$seed" "${argv[@]}" <<'LUA'
package.path = './lib/?.lua;' .. package.path
local d, f = require('drbg'), require('fixed')
local rng = d.new(string.rep('\0',31) .. string.char(tonumber(arg[1])))
local method, first, last = arg[2], tonumber(arg[3]), tonumber(arg[4])
local m, e = f.from_int(first)
for _=1,30 do
	local value
	if method == 'poisson' then value = rng:poisson(m,e)
	else value = rng[method](rng,first,last) end
	io.write(string.format('%.0f', value) .. '\n')
end
print('pos=' .. rng:position())
LUA
)" || exit 1
		actual="$("$roc_kernel" integer "${argv[0]}" "$seed" 30 "${argv[1]}" "${argv[2]}")" || exit 1
		if [ "$actual" != "$expected" ]; then
			echo "Roc core test FAILED: $spec seed $seed integer/cursor sequence" >&2
			diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2
			exit 1
		fi
		integer_checks=$((integer_checks + 30))
	done
done
printf 'Roc native integer samplers: %s unbiased range, normalized and Poisson values/cursors passed.\n' "$integer_checks"

# Default shapes alone never exercise gamma's alpha<1 branch. The same
# oracle also pins custom means, scales and rates, including byte cursors.
custom_cases="$(luajit - <<'LUA'
package.path = './lib/?.lua;' .. package.path
local d, f = require('drbg'), require('fixed')
local shapes = {
	{'normal','-3','2'}, {'normal','0.125','0.5'},
	{'exponential','0.125','0'}, {'exponential','20','0'},
	{'log_normal','-2','0.5'}, {'log_normal','0.125','2'},
	{'beta','0.5','0.25'}, {'beta','0.999','1'},
	{'beta','1','3'}, {'beta','7','0.5'},
}
local function integer(n) return (tostring(n):gsub('LL$', '')) end
for _, seed in ipairs({0,42,254}) do
	for _, shape in ipairs(shapes) do
		local am, ae = f.parse(shape[2]); local bm, be = f.parse(shape[3])
		local rng = d.new(string.rep('\0',31) .. string.char(seed))
		local values = {}
		for _=1,20 do
			local m,e
			if shape[1] == 'exponential' then m,e = rng:exponential(am,ae)
			else m,e = rng[shape[1]](rng,am,ae,bm,be) end
			values[#values+1] = integer(m) .. ',' .. e
		end
		values[#values+1] = 'pos=' .. rng:position()
		print(table.concat({shape[1],seed,20,integer(am),ae,integer(bm),be},' ') .. '\t' .. table.concat(values,'|'))
	end
end
LUA
)" || exit 1
custom_checks=0
while IFS=$'\t' read -r arguments expected; do
	read -r -a argv <<<"$arguments"
	actual="$("$roc_kernel" sample_params "${argv[@]}")" || exit 1
	actual="${actual//$'\n'/|}"
	if [ "$actual" != "$expected" ]; then
		echo "Roc core test FAILED: custom $arguments value/consumption sequence" >&2
		exit 1
	fi
	custom_checks=$((custom_checks + argv[2]))
done <<<"$custom_cases"
if [ "$custom_checks" -ne 600 ]; then
	echo "Roc core test FAILED: incomplete custom-parameter corpus ($custom_checks)" >&2
	exit 1
fi
printf 'Roc native custom samplers: %s exact values/cursors passed, including alpha<1.\n' "$custom_checks"

# ASCII codecs preserve the exact existing Fixed parser/formatter order.
codec_corpus="$(luajit - <<'LUA'
package.path='./lib/?.lua;'..package.path
local f,g,b=require('fixed'),require('geometric'),require('blake3')
local texts={'0','1','-1','+42',' 42 ','\t.125\n','1.','-.5',
'9007199254740992','9007199254740993','-9007199254740992','-9007199254740993',
'123456789012345678','9223372036854775807','9223372036854775808',
'18446744073709551616','-18446744073709551616',
'0.123456789012345678901234567890','1.9999999999999999999',
'', '.', '+', '-', '1e-3', '1.2.3', '1x','1 2', ' 1',
string.rep('9',2000),string.rep('9',2001),string.rep('0',2001)}
for length=1,40 do
	texts[#texts+1]=string.rep('9',length)
	texts[#texts+1]='0.'..string.rep('9',length)
	texts[#texts+1]='-0.'..string.rep('0',length)..'1'
end
local function pair(m,e) return (tostring(m):gsub('LL$',''))..','..e end
for _,s in ipairs(texts) do
	local m,e=f.parse(s)
	print('parse\t'..(s=='' and '@' or b.bin_to_hex(s))..'\t'..(m and pair(m,e) or 'INVALID'))
	local integer=f.parse_int_safe(s)
	print('integer_parse\t'..(s=='' and '@' or b.bin_to_hex(s))..'\t'..(integer and string.format('%.0f',integer) or 'INVALID'))
end
local ps={'1','0.5','0.999','.125','1e-20','2^-100','2^-1000000',
	'1e-300000','1e-301029','1e-301030','1e-1000000','1e-1000001',
	'1E+0','0e3','-1e-3','+1e-3',' 2^-2 ',' 1e-2 ','2^1',
	'2^-1000001','2^--3','1e--3','0','-0.1','2','1.2','1.2.3'}
for _,s in ipairs(ps) do
	local m,e=g.parse_probability(s)
	print('probability\t'..b.bin_to_hex(s)..'\t'..(m and pair(m,e) or 'INVALID'))
end
for _,m in ipairs({0x4000000000000000LL,0x4000000000000001LL,
	0x6000000000000003LL,0x7fffffffffffffffLL}) do
	for _,e in ipairs({-1000000,-1000,-63,-30,-3,-1,0,1,3,20,53,61,62,63,100,2043}) do
		for _,sign in ipairs({1LL,-1LL}) do
			for _,places in ipairs({0,1,6,17,18}) do
				print('render\t'..pair(m*sign,e):gsub(',',' ')..' '..places..'\t'..f.tostring(m*sign,e,places))
			end
		end
	end
end
LUA
)" || exit 1
codec_checks=0
while IFS=$'\t' read -r op arguments expected; do
	if [ "$op" = render ]; then
		read -r -a argv <<<"$arguments"
	else
		if [ "$arguments" = @ ]; then input=""
		else input="$(printf '%s' "$arguments" | xxd -r -p)"; fi
		argv=("$input")
	fi
	actual="$("$roc_kernel" "$op" "${argv[@]}")"
	status=$?
	if [ "$expected" = INVALID ]; then
		if [ "$status" -eq 0 ]; then
			printf 'FAIL: %s %q accepted\n' "$op" "$arguments" >&2
			exit 1
		fi
	elif [ "$status" -ne 0 ] || [ "$actual" != "$expected" ]; then
		printf 'FAIL: %s %q => %s status %s; expected %s\n' "$op" "$arguments" "$actual" "$status" "$expected" >&2
		exit 1
	fi
	codec_checks=$((codec_checks+1))
done <<<"$codec_corpus"
printf 'Roc decimal/probability codec: %s independent runtime cases passed.\n' "$codec_checks"
if [ "$codec_checks" -ne 969 ]; then
	echo "Roc core test FAILED: incomplete decimal/probability corpus ($codec_checks)" >&2
	exit 1
fi
