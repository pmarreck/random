		random -n --mean 5 --stddev 0 -c 1 || (( fails++ ))

	(( tests++ ))
	echo "Testing --stddev -1 is rejected cleanly..."
	assert_clean_cli_error "--stddev -1 rejected cleanly" \
		random -n --mean 5 --stddev -1 -c 1 || (( fails++ ))

	# Test 49: --poisson --mean must be positive (mean IS the poisson rate
	# parameter lambda, which is undefined at <= 0) -- but --mean is
	# shared with --normalized and --log-normal, where negative and zero
	# ARE valid (see Section 10's negative-mean tests above), so this
	# check is necessarily distribution-conditional, not a blanket
	# --mean rule.
	(( tests++ ))
	echo "Testing --poisson --mean 0 is rejected cleanly..."
	assert_clean_cli_error "--poisson --mean 0 rejected cleanly" \
		random --poisson --mean 0 -c 1 || (( fails++ ))

	(( tests++ ))
	echo "Testing --poisson --mean -5 is rejected cleanly..."
	assert_clean_cli_error "--poisson --mean -5 rejected cleanly" \
		random --poisson --mean -5 -c 1 || (( fails++ ))

	# Test 50: negative --mean is still accepted for --normalized (the
	# distribution-conditional check above must not become a blanket
	# rejection of negative --mean).
	(( tests++ ))
	echo "Testing --normalized --mean -5 is still accepted..."
	if random -n --mean -5 --stddev 1 -c 1 >/dev/null 2>&1; then
		echo "✓ --normalized --mean -5 still accepted"
	else
		echo "✗ --normalized --mean -5 was wrongly rejected" >&2
		(( fails++ ))
	fi

	# Test 51: no floating-point math remains on the deterministic path
	(( tests++ ))
	echo "Testing bin/random contains no libm calls..."

	local libm_hits
	libm_hits=$(grep -nE 'math\.(log|cos|sin|exp|pow|sqrt|pi)|tonumber\(argv|string\.format\("%\.?[0-9]*f' \
		"$(command -v random)" | grep -v '^[0-9]*:--' || true)

	if [ -z "$libm_hits" ]; then
		echo "✓ No libm calls remain"
	else
		echo "✗ libm calls still present:" >&2
		echo "$libm_hits" >&2
		(( fails++ ))
	fi

	# ===== Final results =====
	echo ""
	echo "============================================"
	if [ $fails -gt 0 ]; then
		echo "random test FAILED: $fails of $tests tests failed" >&2
		return $fails
	else
		echo "random test PASSED: All $tests tests passed"
		return 0
	fi
}

# Run the test if this script is executed directly
	test_random
	exit $?
