#!/usr/bin/env bash
# Direct LuaJIT FFI controls: independent algorithms, no replacement RNG host.
set -u
ulimit -c 0 || exit 1
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
cd "$root" || exit 1
source "$root/tests/bend_native_setup.sh" || exit 1
bend_native_setup || exit 1
luajit tests/bend2_ffi_test.lua "$RANDOM_BEND_SHARED_LIBRARY" || exit 1
luajit tests/bend2_model_ffi_test.lua "$RANDOM_BEND_SHARED_LIBRARY" "$RANDOM_BEND_ORACLE_LIBRARY" || exit 1
luajit tests/bend2_stream_ffi_test.lua "$RANDOM_BEND_SHARED_LIBRARY" "$RANDOM_BEND_ORACLE_LIBRARY" || exit 1
LUA_PATH='./lib/?.lua;;' luajit tests/geometric_ffi.lua "$RANDOM_BEND_SHARED_LIBRARY" randomb || exit 1
