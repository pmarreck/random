#!/usr/bin/env bash
# Opt-in release microbenchmarks. Only build artifacts touch TMPDIR; payloads
# and timing exports stay in pipes. Nothing here changes production dispatch.
set -u
set -o pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root" || exit 1
check_only=0
case "${1-}" in "") ;; --check) check_only=1 ;; *) echo 'Usage: bm-fixed-simd [--check]' >&2; exit 1;; esac
work="$(mktemp -d "${TMPDIR:-/tmp}/random-simd.XXXXXX")" || exit 1
echo "SIMD build artifacts: $work (retained for inspection)" >&2
if [ "$(uname -m)" != x86_64 ]; then
	echo 'This Zig/Rust AVX2 comparison currently requires an x86_64 host.' >&2
	exit 1
fi

zig_modules=(-O ReleaseFast -mcpu=native --dep fixed --dep candidate
	-Mroot=experiments/fixed_simd_bench.zig
	-O ReleaseFast -mcpu=native --dep fixed -Mcandidate=experiments/fixed_simd.zig
	-O ReleaseFast -mcpu=native -Mfixed=src/fixed.zig)
# The full command below pins optimization per module; -M resets these flags.
# Deliberately don't inherit a Debug math module into a release benchmark.
zig test -O ReleaseSafe -mcpu=native --dep fixed --dep candidate \
	-Mroot=experiments/fixed_simd_test.zig \
	-O ReleaseSafe -mcpu=native --dep fixed -Mcandidate=experiments/fixed_simd.zig \
	-O ReleaseSafe -mcpu=native -Mfixed=src/fixed.zig || exit 1
zig build-exe "${zig_modules[@]}" -femit-bin="$work/zig" -femit-asm="$work/zig.s" || exit 1

# Cargo tells us the exact library artifact; no store/path search or ambient rlib.
artifacts=$(CARGO_TARGET_DIR="$work/cargo" RUSTFLAGS='-C target-cpu=native' \
	cargo build --locked --release -p randomr --message-format=json) || exit 1
rlib=$(jq -r 'select(.reason == "compiler-artifact" and .target.name == "randomr") |
	.filenames[] | select(endswith(".rlib"))' <<<"$artifacts") || exit 1
if [ ! -f "$rlib" ]; then echo 'Cargo did not provide one randomr rlib' >&2; exit 1; fi
rust_flags=(--edition 2024 -C opt-level=3 -C target-cpu=native --extern "randomr=$rlib"
	-L "dependency=$work/cargo/release/deps")
rustc "${rust_flags[@]}" -C debug-assertions=yes -C overflow-checks=yes \
	--test experiments/fixed_simd.rs -o "$work/rust-test" || exit 1
"$work/rust-test" || exit 1
rustc "${rust_flags[@]}" experiments/fixed_simd.rs -o "$work/rust" || exit 1

timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
commit=$(git rev-parse HEAD)
source_digest=$(sha256sum experiments/fixed_simd.zig experiments/fixed_simd.rs \
	experiments/fixed_simd_bench.zig src/fixed.zig rust/randomr/src/fixed.rs | sha256sum | awk '{print $1}')
cpu=$(awk -F ': ' '/^model name/{print $2;exit}' /proc/cpuinfo 2>/dev/null)
cpu="${cpu:-$(uname -m)}"
history="${BM_SIMD_RESULTS_FILE:-$root/benchmarks/fixed-simd.ndjson}"
runs="${BM_RUNS:-5}"
warmup="${BM_WARMUP:-3}"
for op in ln cos mul; do
	expected=""
	commands=()
	names=()
	for language in zig rust; do
		for variant in scalar vector; do
			value=$("$work/$language" "$variant-$op" --verify |
				awk 'NF != 2 || $1 !~ /^-?[0-9]+$/ || $2 !~ /^-?[0-9]+$/ {bad=1}
					{print} END {if (bad || NR != 8192) exit 1}' |
				sha256sum | awk '{print $1}') || exit 1
			if [ -z "$expected" ]; then expected="$value"; fi
			if [ "$value" != "$expected" ]; then
				echo "$language/$variant-$op differs from the scalar oracle" >&2
				exit 1
			fi
			names+=("$language/$variant-$op")
			commands+=(-n "$language/$variant-$op" "$work/$language $variant-$op")
		done
	done
	echo "$op: all four canonical-output SHA-256 digests agree ($expected)" >&2
	[ "$check_only" -eq 0 ] || continue
	result=$(hyperfine -N --warmup "$warmup" --runs "$runs" --export-json /dev/fd/3 \
		"${commands[@]}" 3>&1 1>&2) || exit 1
	names_json=$(printf '%s\n' "${names[@]}" | jq -Rsc 'split("\n")[:-1]') || exit 1
	parsed=$(jq -cse --argjson expected "$names_json" \
		-f "$root/tools/hyperfine_results.jq" <<<"$result") || exit 1
	jq -c --arg timestamp "$timestamp" --arg commit "$commit" --arg cpu "$cpu" \
		--arg source_digest "$source_digest" --arg op "$op" --arg digest "$expected" \
		--arg zig_version "$(zig version)" --arg rust_version "$(rustc --version)" \
		--argjson runs "$runs" --argjson warmup "$warmup" \
		'. + {timestamp:$timestamp, parent_commit:$commit, source_sha256:$source_digest,
		cpu:$cpu, target_cpu:"native", operation:$op, output_sha256:$digest,
		samples:(if $op == "mul" then 33554432 else 1048576 end),
		zig_version:$zig_version, rust_version:$rust_version, runs:$runs, warmup:$warmup,
		cpu_seconds:(.user + .system), output_sink:"null", production_enabled:false}' \
		<<<"$parsed" >>"$history" || exit 1
	jq -rs 'group_by(.command | split("/")[0])[] |
		(map(select(.command | contains("/scalar-")))[0]) as $s |
		(map(select(.command | contains("/vector-")))[0]) as $v |
		"\($s.command | split("/")[0]): vector CPU speedup \(($s.user+$s.system)/($v.user+$v.system))x; review exact-output controls before promotion"' \
		<<<"$parsed" >&2
done
if [ "$check_only" -eq 0 ]; then echo "Measurements appended to $history" >&2; fi
