#!/usr/bin/env bash
# The benchmark runner records this adapter and the complete source snapshot.
set -u
set -o pipefail
if [ "$#" -ne 3 ] || [ "$3" != "${RANDOM_ZIGGURAT_EXPECTED_SEED:?expected seed required}" ]; then
	echo 'Ziggurat probe requires matching independently prepared seed/work oracles' >&2; exit 1
fi
expected="$(jq -er --arg case "$1" --arg sizes "$2" '
	($case|sub("-[0-9]+(-growth)?$";"")) as $name |
	.[$name] as $counts | $sizes|split(",")|map($counts[.] // error("missing work oracle"))|join(",")
	' <<< "${RANDOM_ZIGGURAT_EXPECTED_JSON:?independent work oracles required}")" || exit 1
exec "${RANDOM_ZIGGURAT_ARTIFACTS:?build experiments first}/ziggurat-bench" "$@" "$expected"
