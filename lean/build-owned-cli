#!/usr/bin/env bash
set -euo pipefail

lean_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$lean_dir/.." && pwd)"
ir="$lean_dir/.lake/build/ir/Randoml"
if [ "$#" -gt 0 ]; then
	case "$1" in
		/*) output="$1" ;;
		*) output="$(pwd)/$1" ;;
	esac
else
	output="$lean_dir/.lake/build/bin/randoml"
fi

cd "$lean_dir"
modules=(Native Blake3 Fixed Drbg ZigguratTables Ziggurat Distribution Geometric
	Decimal Curve GeneratedCharts Chart CliOptions CliSource State Shuffle Cli)
facets=()
objects=()
for module in "${modules[@]}"; do
	facets+=("Randoml.$module:c.o.export")
	objects+=("$ir/$module.c.o.export")
done
# Lake owns native object freshness, compiler flags and dependency traces.
# Recompiling every generated C file on every test invocation exhausted the
# state suite's budget before its complete five-language matrix could finish.
lake build Randoml Randoml.Cli "${facets[@]}"
mkdir -p "$(dirname "$output")"

# leanc supplies both compiler and runtime linker flags. Compile and link in
# one invocation so linker inputs are consumed, not passed to compile-only jobs.
lake env leanc -O3 -I"$root/src" -o "$output" \
	"$lean_dir/randoml_launcher.c" "$lean_dir/randoml_native.c" \
	"${objects[@]}"

# This script is the production/release linker, not Lean's development build.
# Strip here so direct builds have the same release policy as packaged builds.
# The no-option form means "all removable symbols" in GNU, LLVM, and Apple
# strip while retaining the dynamic-link information required at runtime.
"${STRIP:-strip}" "$output"
