#!/usr/bin/env bash
# Compatibility fallback for shells which still cache generic bin/. Fresh PATH
# discovery selects bin/PF first and launches the native executable directly.
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$here/build-support/core.sh"
pf="$(rb_platform "$(uname -s)" "$(uname -m)")" || exit 1
name="${0##*/}"
candidate="$here/bin/$pf/$name"
[[ "$pf" != mswin-* ]] || candidate="$candidate.exe"
if [ ! -x "$candidate" ]; then
	printf '%s\n' '{"sv":3,"error":{"code":"build","message":"No host product is published. Run ./build, then refresh project PATH."}}' >&2
	exit 127
fi
exec "$candidate" "$@"
