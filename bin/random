#!/usr/bin/env luajit

--[[
Unified random number generator
- Multiple distributions: uniform, normal, exponential, poisson, log-normal, beta
- True random from the OS CSPRNG (default) or deterministic BLAKE3 keyed XOF
- Stdin operations: --choose, --shuffle, --weighted
- Output formats: decimal, hex, base64, binary
- Symlink-aware: 'nrandom' implies --normalized, 'drandom' implies --deterministic
]]

local ffi = require("ffi")
local bit = require("bit")

local here = (arg[0] or ""):match("^(.*)/[^/]+$") or "."
package.path = here .. "/../lib/?.lua;" .. here .. "/lib/?.lua;" .. package.path
local fx = require("fixed")
local b3 = require("blake3")
local distribution_charts = require("distribution_charts")
local distribution_view = require("distribution_view")

local argv = arg or {}

-- ===== FFI declarations =====
ffi.cdef[[
	long getrandom(void *buf, size_t buflen, unsigned int flags);
	int getentropy(void *buffer, size_t length);
	int _setmode(int fd, int mode);
	int isatty(int fd);
	int _isatty(int fd);
	typedef long NTSTATUS;
	NTSTATUS BCryptGenRandom(void *algorithm, unsigned char *buffer,
		unsigned long length, unsigned long flags);
]]

if jit.os == "Windows" then
	-- The Microsoft CRT otherwise expands every LF byte written to stdout and
	-- treats stdin as text, corrupting deterministic and true-random streams.
	local O_BINARY = 0x8000
	if ffi.C._setmode(1, O_BINARY) == -1 or ffi.C._setmode(0, O_BINARY) == -1 then
		io.stderr:write("Error: could not put standard streams in binary mode\n")
		os.exit(1)
	end
end

local u64 = ffi.typeof("uint64_t")

-- ===== Utility functions =====
local function stderr_write(msg)
	io.stderr:write(msg)
end

local function shell_quote(s)
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function exec_status(cmd)
	local ok, reason, code = os.execute(cmd)
	if type(ok) == "number" then
		if jit.os == "Windows" then return ok end
		if ok == -1 then return 1 end
		local signal = bit.band(ok, 0x7f)
		if signal ~= 0 then return 128 + signal end
		return bit.rshift(ok, 8)
	end
	if ok == true then return 0 end
	if reason == "exit" and type(code) == "number" then return code end
	return 1
end

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- ===== Base64 encoding =====
local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function base64_encode(data)
	local result = {}
	local len = #data
	local i = 1
	while i <= len do
		local a = string.byte(data, i) or 0
		local b = string.byte(data, i + 1) or 0
		local c = string.byte(data, i + 2) or 0

		local n = a * 65536 + b * 256 + c

		local c1 = bit.rshift(n, 18) % 64
		local c2 = bit.rshift(n, 12) % 64
		local c3 = bit.rshift(n, 6) % 64
		local c4 = n % 64

		result[#result + 1] = b64chars:sub(c1 + 1, c1 + 1)
		result[#result + 1] = b64chars:sub(c2 + 1, c2 + 1)

		if i + 1 <= len then
			result[#result + 1] = b64chars:sub(c3 + 1, c3 + 1)
		else
			result[#result + 1] = "="
		end

		if i + 2 <= len then
			result[#result + 1] = b64chars:sub(c4 + 1, c4 + 1)
		else
			result[#result + 1] = "="
		end

		i = i + 3
	end
	return table.concat(result)
end

-- ===== Seed parsing and BLAKE3 DRBG =====

local KDF_CONTEXT = "random drbg 2026-08-04 v1"
local MAX_EXACT_INTEGER = 9007199254740992 -- 2^53

local function bytes_to_hex(bytes)
	return b3.bin_to_hex(bytes)
end

-- Parse an unsigned integer no wider than 256 bits and serialize it as one
-- canonical 32-byte big-endian value. Decimal and 0x-prefixed hexadecimal are
-- two spellings of the same mathematical seed; no other grammar is accepted.
local function parse_seed(seed_str)
	if type(seed_str) ~= "string" or seed_str == "" then return nil end

	local bytes = {}
	for i = 1, 32 do bytes[i] = 0 end

	if seed_str:match("^[0-9]+$") then
		for i = 1, #seed_str do
			local carry = seed_str:byte(i) - 48
			for j = 32, 1, -1 do
				local value = bytes[j] * 10 + carry
				bytes[j] = value % 256
				carry = math.floor(value / 256)
			end
			if carry ~= 0 then return nil end
		end
	elseif seed_str:match("^0[xX][0-9A-Fa-f]+$") then
		local digits = seed_str:sub(3)
		if #digits > 64 then return nil end
		if #digits % 2 == 1 then digits = "0" .. digits end
		local first = 33 - #digits / 2
		for i = 1, #digits, 2 do
			bytes[first] = tonumber(digits:sub(i, i + 1), 16)
			first = first + 1
		end
	else
		return nil
	end

	return string.char(unpack(bytes))
end

local drbg_stream
local drbg_pos = 0

local function drbg_seed(seed_material)
	local key = b3.hex_to_bin(b3.blake3_derive_key(seed_material, KDF_CONTEXT, 32))
	drbg_stream = b3.blake3("", key, -1)
	drbg_pos = 0
end

local function drbg_draw_bytes(count)
	if type(count) ~= "number" or count < 0 or count ~= math.floor(count) or
		drbg_pos > MAX_EXACT_INTEGER - count then
		error("BLAKE3 DRBG byte position exceeds the Lua oracle's exact-integer limit", 2)
	end
	local bytes = b3.hex_to_bin(drbg_stream(count))
	drbg_pos = drbg_pos + count
	return bytes
end

local function drbg_draw_u32()
	local bytes = drbg_draw_bytes(4)
	local value = 0
	for i = 1, 4 do value = value * 256 + bytes:byte(i) end
	return value
end

local function drbg_draw_u64()
	local bytes = drbg_draw_bytes(8)
	local value = ffi.new(u64, 0)
	for i = 1, 8 do value = value * 256 + bytes:byte(i) end
	return value
end

-- Uniform integer in [start_val, end_val] by rejection sampling. Narrow
-- ranges consume one big-endian u32; wide ranges consume one big-endian u64.
local function drbg_range(start_val, end_val)
	local range = end_val - start_val + 1
	if range <= 1 then return start_val end
	if range <= 4294967296 then
		local bound = 4294967296 - (4294967296 % range)
		while true do
			local r = drbg_draw_u32()
			if r < bound then
				return start_val + (r % range)
			end
		end
	end
	-- Wide path: consume one exact big-endian 64-bit draw.
	local urange = ffi.cast(u64, range)
	-- Compute bound using unsigned arithmetic that stays entirely in u64.
	-- 0 - urange gives 2^64 - range by wraparound; mod range gives 2^64 mod range.
	local remainder = (ffi.cast(u64, 0) - urange) % urange   -- 2^64 mod range
	-- When remainder is 0, range divides 2^64 exactly (every power of two
	-- from 2^33 up -- 2^32 and below take the narrow path above and never
	-- reach here). `bound = 0 - remainder` would then be 0 in u64
	-- wraparound arithmetic, which is not "reject everything", it is
	-- unrepresentable: no u64 draw can ever satisfy `r < 0`, so the
	-- rejection loop below spun forever for every such range -- confirmed
	-- directly, `random --seed 42 -c 1 0..8589934591` (span 2^33) hung
	-- until killed. There is nothing to reject in this case: every 64-bit
	-- draw already lands in exactly range/2^64 proportion, so ALL draws
	-- are unbiased and none need to be rejected. exact_divides short-
	-- circuits the loop's `r < bound` check rather than trying to make
	-- bound represent "accept everything" as a u64 value, which it
	-- cannot.
	local exact_divides = (remainder == 0)
	local bound = ffi.cast(u64, 0) - remainder               -- 2^64 - (2^64 mod range); meaningless when exact_divides
	while true do
		local r = drbg_draw_u64()
		if exact_divides or r < bound then
			return start_val + tonumber(r % urange)
		end
	end
end

-- Draws are exact 32-bit integers k, and k/2^32 is exact too (2^32 is a
-- power of two), so this soft-float division has no rounding to worry
-- about at all -- unlike the transcendental functions below it feeds.
local TWO32_M, TWO32_E = fx.from_int(4294967296)

-- Get uniform random in [0, 1) as a soft-float (m, e).
local function drbg_uniform()
	local km, ke = fx.from_int(drbg_draw_u32())
	return fx.div(km, ke, TWO32_M, TWO32_E)
end

-- ===== Fail-closed OS entropy =====

local function entropy_fatal(message)
	stderr_write("Error: entropy " .. message .. "\n")
	os.exit(1)
end

local function exact_file_reader(path)
	local file, open_error = io.open(path, "rb")
	if not file then entropy_fatal("source could not be opened: " .. tostring(open_error)) end
	return function(count)
		local parts = {}
		local remaining = count
		while remaining > 0 do
			local part = file:read(remaining)
			if not part or #part == 0 then
				entropy_fatal("source reached EOF before " .. count .. " bytes were read")
			end
			parts[#parts + 1] = part
			remaining = remaining - #part
		end
		return table.concat(parts)
	end
end

local function getrandom_reader(no_wait)
	return function(count)
		local buffer = ffi.new("uint8_t[?]", count)
		local offset = 0
		while offset < count do
			local ok, result = pcall(function()
				return ffi.C.getrandom(buffer + offset, count - offset, no_wait and 1 or 0)
			end)
			if not ok then return nil, "unavailable" end
			result = tonumber(result)
			if result < 0 then
				local errno = ffi.errno()
				if errno == 4 then -- EINTR
					-- Retry the same source and remaining range.
				elseif errno == 38 then -- ENOSYS
					return nil, "unavailable"
				elseif no_wait and errno == 11 then -- EAGAIN
					entropy_fatal("pool is not initialized and --no-wait was requested")
				else
					entropy_fatal("getrandom failed with errno " .. errno)
				end
			elseif result == 0 then
				entropy_fatal("getrandom returned zero bytes")
			else
				offset = offset + result
			end
		end
		return ffi.string(buffer, count)
	end
end

local function getentropy_reader()
	return function(count)
		local parts = {}
		local remaining = count
		while remaining > 0 do
			local part_size = math.min(remaining, 256)
			local buffer = ffi.new("uint8_t[?]", part_size)
			local ok, result = pcall(function() return ffi.C.getentropy(buffer, part_size) end)
			if not ok then return nil, "unavailable" end
			if tonumber(result) ~= 0 then
				local errno = ffi.errno()
				if errno == 4 then
					-- Retry the same source and remaining range.
				else
					entropy_fatal("getentropy failed with errno " .. errno)
				end
			else
				parts[#parts + 1] = ffi.string(buffer, part_size)
				remaining = remaining - part_size
			end
		end
		return table.concat(parts)
	end
end

local function windows_entropy_reader()
	local ok, bcrypt = pcall(ffi.load, "bcrypt")
	if not ok then return nil end
	return function(count)
		local buffer = ffi.new("uint8_t[?]", count)
		local status = bcrypt.BCryptGenRandom(nil, buffer, count, 0x00000002)
		if tonumber(status) ~= 0 then
			entropy_fatal("BCryptGenRandom failed with status " .. tonumber(status))
		end
		return ffi.string(buffer, count)
	end
end

local function make_entropy_reader(source_path, no_wait)
	if source_path then return exact_file_reader(source_path) end
	if no_wait and jit.os ~= "Linux" then
		entropy_fatal("--no-wait is supported only by Linux getrandom")
	end

	if jit.os == "Windows" then
		local reader = windows_entropy_reader()
		if reader then return reader end
		entropy_fatal("BCryptGenRandom is unavailable")
	end

	local primary = jit.os == "Linux" and getrandom_reader(no_wait) or getentropy_reader()
	local fallback = jit.os == "Linux" and getentropy_reader() or nil
	local device
	return function(count)
		local bytes, status = primary(count)
		if bytes then return bytes end
		if status ~= "unavailable" then entropy_fatal(tostring(status)) end
		if fallback then
			bytes, status = fallback(count)
			if bytes then return bytes end
			if status ~= "unavailable" then entropy_fatal(tostring(status)) end
		end
		device = device or exact_file_reader("/dev/urandom")
		return device(count)
	end
end

local function bytes_to_integer(bytes)
	local result = 0
	for i = 1, #bytes do
		result = result * 256 + string.byte(bytes, i)
	end
	return result
end

local function bytes_to_u64(bytes)
	local result = ffi.new(u64, 0)
	for i = 1, #bytes do result = result * 256 + string.byte(bytes, i) end
	return result
end

local function true_random_range(start_val, end_val, entropy_reader)
	local span = end_val - start_val + 1
	if span <= 1 then return start_val end
	if span <= 4294967296 then
		local bound = 4294967296 - (4294967296 % span)
		while true do
			local draw = bytes_to_integer(entropy_reader(4))
			if draw < bound then return start_val + (draw % span) end
		end
	end

	-- Keep every bit exact on wide ranges. Assembling more than six bytes in a
	-- Lua number silently loses low bits past 2^53; uint64_t cdata preserves
	-- the entire OS draw and mirrors the deterministic sampler's arithmetic.
	local uspan = ffi.cast(u64, span)
	local remainder = (ffi.cast(u64, 0) - uspan) % uspan
	local exact_divides = remainder == 0
	local bound = ffi.cast(u64, 0) - remainder
	while true do
		local draw = bytes_to_u64(entropy_reader(8))
		if exact_divides or draw < bound then
			return start_val + tonumber(draw % uspan)
		end
	end
end

-- Get uniform random in [0, 1) from the entropy source, as a soft-float (m, e).
local function true_random_uniform(entropy_reader)
	local bytes = entropy_reader(4)
	local km, ke = fx.from_int(bytes_to_integer(bytes))
	return fx.div(km, ke, TWO32_M, TWO32_E)
end

-- ===== Distribution functions (integer-only, via lib/fixed.lua) =====

local ONE_M, ONE_E = fx.from_int(1)
local TWO_M, TWO_E = fx.from_int(2)
local NEG2_M, NEG2_E = fx.from_int(-2)
local SIX_M, SIX_E = fx.from_int(6)
local HALF_M, HALF_E = fx.div(ONE_M, ONE_E, TWO_M, TWO_E)

-- Round a soft-float to the nearest integer (ties away from zero), then
-- truncate -- this kernel's ONE rounding rule (truncation toward zero)
-- composed with a SIGN-AWARE half-unit offset so the composite rounds
-- correctly in both directions. "Add 1/2, then truncate toward zero" is
-- round-half-away-from-zero ONLY for a non-negative input; for a negative
-- one it rounds one unit too HIGH (toward zero) instead, e.g.
-- -2.4 + 0.5 = -1.9, trunc = -1, not the correct -2 -- and even an exact
-- negative integer gets bumped: -50 + 0.5 = -49.5, trunc = -49.
--
-- The old, pre-kernel code used math.floor(v + 0.5) -- NOT actually
-- correct in both directions either, despite an earlier version of this
-- comment claiming so: math.floor rounds ties toward +infinity
-- unconditionally, which coincides with "away from zero" only for
-- non-negative v. For a negative tie it rounds one unit too HIGH (toward
-- zero), the identical direction of error the truncate-based formula
-- above has, just reached via a different mechanism: math.floor(-2.5 +
-- 0.5) == math.floor(-2.0) == -2, not the correct ties-away-from-zero -3.
-- Subtracting 1/2 for negative inputs before truncating fixes it: -2.4 -
-- 0.5 = -2.9, trunc = -2 (correct); -50 - 0.5 = -50.5, trunc = -50
-- (correct, exact integers pass through unchanged either way); -2.5 -
-- 0.5 = -3.0, trunc = -3 (correct tie-away-from-zero, unlike math.floor).
local function round_to_int(m, e)
	if m < 0 then
		m, e = fx.sub(m, e, HALF_M, HALF_E)
	else
		m, e = fx.add(m, e, HALF_M, HALF_E)
	end
	return fx.to_int_trunc(m, e)
end

-- Substitute for an exact-zero uniform draw (k=0 out of 2^32), which would
-- otherwise trip fx.ln's positive-argument assertion. The old math.log-based
-- code clamped any draw below 1e-6 (a lazy hack to dodge math.log(0)==-inf,
-- silently biasing roughly 1 in a million draws); ln is well-defined for
-- every OTHER draw all the way down to k=1 (~2.3e-10, ln ~= -22.18, well
-- inside this kernel's documented domain -- see lib/fixed.lua's top-of-file
-- comment), so only the exact-zero case needs a substitute now.
local MIN_UNIFORM_M, MIN_UNIFORM_E = fx.div(ONE_M, ONE_E, TWO32_M, TWO32_E)

-- Normal distribution (Box-Muller) - for integer output with range.
-- rand_func(1, 1000000) is always in [1, 1000000], so u1/u2 can never be
-- exactly zero here -- no MIN_UNIFORM substitution needed, unlike the
-- soft-float uniform_func() path below.
local function normal_random_int(start_val, end_val, rand_func)
	local range = end_val - start_val
	local rng_m, rng_e = fx.from_int(range)
	local sixth_m, sixth_e = fx.div(rng_m, rng_e, SIX_M, SIX_E)
	local half_range_m, half_range_e = fx.div(rng_m, rng_e, TWO_M, TWO_E)
	local start_m, start_e = fx.from_int(start_val)
	local mil_m, mil_e = fx.from_int(1000000)
	local result
	repeat
		local n1m, n1e = fx.from_int(rand_func(1, 1000000))
		local n2m, n2e = fx.from_int(rand_func(1, 1000000))
		local u1m, u1e = fx.div(n1m, n1e, mil_m, mil_e)
		local u2m, u2e = fx.div(n2m, n2e, mil_m, mil_e)
		local lm, le = fx.ln(u1m, u1e)
		local pm, pe = fx.mul(NEG2_M, NEG2_E, lm, le)
		local rm, re = fx.sqrt(pm, pe)
		local cm, ce = fx.cos_turns(u2m, u2e)
		local zm, ze = fx.mul(rm, re, cm, ce)
		-- start + z*(range/6) + range/2, rounded to nearest via round_to_int
		-- (sign-aware: see that function's own doc comment for why a plain
		-- "add 1/2, truncate toward zero" is wrong for negative results).
		local vm, ve = fx.mul(zm, ze, sixth_m, sixth_e)
		vm, ve = fx.add(vm, ve, half_range_m, half_range_e)
		vm, ve = fx.add(vm, ve, start_m, start_e)
		result = round_to_int(vm, ve)
	until result >= start_val and result <= end_val
	return result
end

-- Normal distribution with mean/stddev - returns a soft-float (m, e).
local function normal_random_float(mean_m, mean_e, sd_m, sd_e, uniform_func)
	local u1m, u1e = uniform_func()
	local u2m, u2e = uniform_func()
	if u1m == 0 then u1m, u1e = MIN_UNIFORM_M, MIN_UNIFORM_E end
	local lm, le = fx.ln(u1m, u1e)
	local pm, pe = fx.mul(NEG2_M, NEG2_E, lm, le)
	local rm, re = fx.sqrt(pm, pe)
	local cm, ce = fx.cos_turns(u2m, u2e)     -- cos(2*pi*u2), u2 already in turns
	local zm, ze = fx.mul(rm, re, cm, ce)
	local sm, se = fx.mul(zm, ze, sd_m, sd_e)
	return fx.add(mean_m, mean_e, sm, se)
end

-- Exponential distribution (rate given as a soft-float).
local function exponential_random(rate_m, rate_e, uniform_func)
	local um, ue = uniform_func()
	if um == 0 then um, ue = MIN_UNIFORM_M, MIN_UNIFORM_E end
	local lm, le = fx.ln(um, ue)
	local nm, ne = fx.neg(lm, le)
	return fx.div(nm, ne, rate_m, rate_e)
end

-- Poisson by SUM OF EXPONENTIALS rather than the old product form. The
-- product form (multiply uniforms until p <= e^-lambda) underflows any
-- fixed-width fraction: at lambda=20 the threshold is already 2e-9, well
-- past where a 62-bit product still carries any signal. Counting
-- exponential inter-arrivals (k = count of draws where the running sum of
-- -ln(u_i) first exceeds lambda) is the same Poisson distribution and
-- consumes the same number of uniforms per variate as the product form,
-- but stays well-conditioned across the entire useful lambda range.
local function poisson_random(lambda_m, lambda_e, uniform_func)
	local sum_m, sum_e = 0LL, 0
	local k = 0
	while true do
		local um, ue = uniform_func()
		if um == 0 then um, ue = MIN_UNIFORM_M, MIN_UNIFORM_E end
		local lm, le = fx.ln(um, ue)
		local nm, ne = fx.neg(lm, le)
		sum_m, sum_e = fx.add(sum_m, sum_e, nm, ne)
		if fx.cmp(sum_m, sum_e, lambda_m, lambda_e) > 0 then return k end
		k = k + 1
	end
end

-- Log-normal distribution - returns a soft-float (m, e).
local function lognormal_random(mu_m, mu_e, sigma_m, sigma_e, uniform_func)
	local nm, ne = normal_random_float(mu_m, mu_e, sigma_m, sigma_e, uniform_func)
	return fx.exp(nm, ne)
end

-- Gamma via Marsaglia-Tsang, with Ahrens-Dieter for alpha < 1. Returns a
-- soft-float (m, e).
local function gamma_random(alpha_m, alpha_e, uniform_func)
	if fx.cmp(alpha_m, alpha_e, ONE_M, ONE_E) < 0 then
		local um, ue = uniform_func()
		if um == 0 then um, ue = MIN_UNIFORM_M, MIN_UNIFORM_E end
		local am, ae = fx.add(ONE_M, ONE_E, alpha_m, alpha_e)
		local gm, ge = gamma_random(am, ae, uniform_func)
		local invm, inve = fx.div(ONE_M, ONE_E, alpha_m, alpha_e)
		local pm, pe = fx.pow(um, ue, invm, inve)
		return fx.mul(gm, ge, pm, pe)
	end
	-- Marsaglia and Tsang's method for alpha >= 1
	local third_m, third_e = fx.div(ONE_M, ONE_E, fx.from_int(3))
	local dm, de = fx.sub(alpha_m, alpha_e, third_m, third_e)
	local nine_m, nine_e = fx.from_int(9)
	local nine_d_m, nine_d_e = fx.mul(nine_m, nine_e, dm, de)
	local sq_m, sq_e = fx.sqrt(nine_d_m, nine_d_e)
	local cm, ce = fx.div(ONE_M, ONE_E, sq_m, sq_e)
	local c0331_m, c0331_e = fx.parse("0.0331")
	while true do
		local xm, xe, vm, ve
		repeat
			xm, xe = normal_random_float(0LL, 0, ONE_M, ONE_E, uniform_func)
			local t1m, t1e = fx.mul(cm, ce, xm, xe)
			vm, ve = fx.add(ONE_M, ONE_E, t1m, t1e)
		until fx.cmp(vm, ve, 0LL, 0) > 0
		local v3m, v3e = fx.mul(vm, ve, vm, ve)
		v3m, v3e = fx.mul(v3m, v3e, vm, ve)
		local um, ue = uniform_func()
		local x2m, x2e = fx.mul(xm, xe, xm, xe)
		local x4m, x4e = fx.mul(x2m, x2e, x2m, x2e)
		local bm, be = fx.mul(c0331_m, c0331_e, x4m, x4e)
		local limm, lime = fx.sub(ONE_M, ONE_E, bm, be)
		if fx.cmp(um, ue, limm, lime) < 0 then
			return fx.mul(dm, de, v3m, v3e)
		end
		if um ~= 0 then
			local lum, lue = fx.ln(um, ue)
			local lvm, lve = fx.ln(v3m, v3e)
			local h1m, h1e = fx.mul(HALF_M, HALF_E, x2m, x2e)
			local t2m, t2e = fx.sub(ONE_M, ONE_E, v3m, v3e)
			t2m, t2e = fx.add(t2m, t2e, lvm, lve)
			local t3m, t3e = fx.mul(dm, de, t2m, t2e)
			local rhs_m, rhs_e = fx.add(h1m, h1e, t3m, t3e)
			if fx.cmp(lum, lue, rhs_m, rhs_e) < 0 then
				return fx.mul(dm, de, v3m, v3e)
			end
		end
	end
end

-- Beta distribution using Gamma variates. Returns a soft-float (m, e).
local function beta_random(alpha_m, alpha_e, beta_m, beta_e, uniform_func)
	local xm, xe = gamma_random(alpha_m, alpha_e, uniform_func)
	local ym, ye = gamma_random(beta_m, beta_e, uniform_func)
	local sm, se = fx.add(xm, xe, ym, ye)
	return fx.div(xm, xe, sm, se)
end

-- ===== Invocation name detection =====
local function get_invocation_name()
	local script_path = argv[0] or "random"
	return script_path:match("([^/]+)$") or "random"
end

-- ===== Help and about =====
-- Keep in sync with flake.nix's `version = "0.1.0"` -- there is no single
-- source of truth shared between the two today (a Lua script has no build
-- step to inject a version at); this is the same manual-sync tradeoff
-- LUAJIT_1499_FIXED_IN already carries elsewhere in this project, recorded
-- rather than silently risked.
local VERSION = "0.1.0"

-- Per this fleet's mandatory CLI convention: --about must show a one-line
-- description, the app's version, and the platform/chip architecture --
-- not bare prose (that was this exact finding: an audit caught --about
-- printing only a description sentence, with no version or platform/arch
-- at all). `jit.os`/`jit.arch` report the interpreter's OWN current
-- platform -- the closest equivalent a non-compiled LuaJIT script has to
-- "the platform and architecture it was compiled for", since there is no
-- separate compile step to fix that information at build time.
local function print_about(invocation)
	local desc
	if invocation == "nrandom" then
		desc = "CSPRNG for normal variates with OS entropy or cross-platform-identical deterministic streams"
	elseif invocation == "drandom" then
		desc = "Cross-platform-identical deterministic CSPRNG using a seeded BLAKE3 keyed XOF"
	else
		desc = "CSPRNG with OS entropy, cross-platform-identical deterministic streams, and alternate distributions"
	end
	print(("%s v%s (%s/%s): %s"):format(invocation, VERSION, jit.os, jit.arch, desc))
end

local function terminal_program_kind(value)
	if not value then return nil end
	value = value:lower()
	if value == "wezterm" then return "wezterm" end
	if value == "ghostty" or value == "kitty" then return "kitty" end
	return nil
end

local function environment_present(name)
	local value = os.getenv(name)
	return value ~= nil and value ~= ""
end

local function terminal_kind()
	if environment_present("WEZTERM_PANE") or environment_present("WEZTERM_EXECUTABLE") then
		return "wezterm"
	end
	if os.getenv("TERM") == "xterm-kitty" or environment_present("KITTY_WINDOW_ID") or
		environment_present("GHOSTTY_RESOURCES_DIR") then return "kitty" end
	local direct = terminal_program_kind(os.getenv("TERM_PROGRAM"))
	if direct then return direct end
	return nil
end

local function stdout_is_tty()
	if jit.os == "Windows" then return ffi.C._isatty(1) == 1 end
	return ffi.C.isatty(1) == 1
end

local function chart_renderer_flag()
	local selected
	for _, value in ipairs(argv) do
		if value == "--kitty" then selected = "kitty"
		elseif value == "--sixel" then selected = "sixel"
		elseif value == "--utf8" or value == "--utf8-graphics" then selected = "utf8" end
	end
	return selected
end

local function chart_renderer()
	local selected = chart_renderer_flag()
	if selected then return selected end
	local requested = os.getenv("RANDOMZ_CHART_TYPE")
	if requested and requested ~= "" then
		requested = requested:lower()
		if requested == "utf8" or requested == "kitty" or requested == "sixel" then
			return requested
		end
		stderr_write("Error: RANDOMZ_CHART_TYPE must be utf8, kitty, or sixel\n")
		os.exit(1)
	end
	if not stdout_is_tty() then return "utf8" end
	-- Terminal images in tmux are not reliably scrollback-attached even when
	-- the outer terminal and tmux both advertise the underlying protocol.
	-- Forced flags still let an informed user opt in for one invocation.
	if environment_present("TMUX") then return "utf8" end
	local kind = terminal_kind()
	if kind == "wezterm" then return "sixel" end
	if kind == "kitty" then return "kitty" end
	return "utf8"
end

local function write_kitty_sequence(control, payload, tmux)
	local sequence = "\27_G" .. control .. ";" .. payload .. "\27\\"
	if tmux then
		sequence = "\27Ptmux;" .. sequence:gsub("\27", "\27\27") .. "\27\\"
	end
	io.write(sequence)
end

local function write_sixel(data)
	-- Sixel is a DCS protocol. tmux 3.4+ parses it natively when built with
	-- Sixel support, so unlike Kitty APC it must not be passthrough-wrapped.
	io.write("\27" .. "7\27P0;1;0q", data, "\27\\\27" .. "8")
	io.write(string.rep("\r\n", 12))
end

local function print_distribution_help(key)
	local chart = key and distribution_charts[key]
	if not chart then return end
	print("")
	print("Distribution: " .. chart.title)
	print(chart.parameters)
	print("")
	local renderer = chart_renderer()
	if renderer == "kitty" then
		local encoded = chart.png_base64
		local tmux = environment_present("TMUX")
		for offset = 1, #encoded, 4096 do
			local final = offset + 4095 >= #encoded
			local control
			if offset == 1 then
				control = "a=T,f=100,t=d,c=56,r=12,C=1,q=2,m=" .. (final and "0" or "1")
			else
				control = "m=" .. (final and "0" or "1")
			end
			write_kitty_sequence(control, encoded:sub(offset, offset + 4095), tmux)
		end
		io.write(string.rep("\r\n", 12))
	elseif renderer == "sixel" then
		write_sixel(chart.sixel_data)
	else
		io.write(chart.fallback)
	end
	print(chart.axis)
end

local view_titles = {
	normal = "Normal (Gaussian)",
	exponential = "Exponential",
	poisson = "Poisson",
	log_normal = "Log-normal",
	beta = "Beta",
}

local view_axes = {
	normal = "Horizontal axis: mean +/- 4 standard deviations; vertical axis: relative probability density.",
	exponential = "Horizontal axis: 0 to 6/rate; vertical axis: relative probability density.",
	poisson = "Horizontal axis: lambda +/- 6*sqrt(lambda), clipped at zero; vertical axis: probability mass.",
	log_normal = "Horizontal axis: 0 to exp(mean + min(1.625*stddev, 20)); vertical axis: relative probability density.",
	beta = "Horizontal axis: value from 0 to 1; vertical axis: relative probability density.",
}

local function selected_distribution_key(options)
	if options.normalized then return "normal" end
	if options.exponential then return "exponential" end
	if options.poisson then return "poisson" end
	if options.log_normal then return "log_normal" end
	if options.beta then return "beta" end
	return nil
end

local function distribution_view_spec(options)
	local key = selected_distribution_key(options)
	local zero = { 0LL, 0 }
	local one = { ONE_M, ONE_E }
	local two = { TWO_M, TWO_E }
	if key == "normal" or key == "log_normal" then
		local mean = options.mean or zero
		local stddev = options.stddev or one
		return key, mean, stddev,
			("Parameters: mean=%s, stddev=%s."):format(
				options.mean_text or "0", options.stddev_text or "1")
	elseif key == "exponential" then
		return key, options.rate or one, zero,
			("Parameters: rate=%s."):format(options.rate_text or "1")
	elseif key == "poisson" then
		return key, options.lambda or options.mean or one, zero,
			("Parameters: lambda=%s."):format(
				options.lambda_text or options.mean_text or "1")
	elseif key == "beta" then
		return key, options.alpha or two, options.beta_param or two,
			("Parameters: alpha=%s, beta=%s."):format(
				options.alpha_text or "2", options.beta_param_text or "2")
	end
end

local function print_distribution_view(options)
	local key, first, second, parameters = distribution_view_spec(options)
	local renderer = chart_renderer()
	local ok, payload = pcall(distribution_view.render, key, first, second, renderer)
	if not ok then
		stderr_write("Error: supplied distribution parameters cannot be charted: " ..
			tostring(payload) .. "\n")
		os.exit(1)
	end
	print("Distribution: " .. view_titles[key])
	print(parameters)
	print("")
	if renderer == "kitty" then
		local tmux = environment_present("TMUX")
		for offset = 1, #payload, 4096 do
			local final = offset + 4095 >= #payload
			local control
			if offset == 1 then
				control = "a=T,f=24,s=336,v=144,c=56,r=12,C=1,q=2,m=" ..
					(final and "0" or "1")
			else
				control = "m=" .. (final and "0" or "1")
			end
			write_kitty_sequence(control, payload:sub(offset, offset + 4095), tmux)
		end
		io.write(string.rep("\r\n", 12))
	elseif renderer == "sixel" then
		write_sixel(payload)
	else
		io.write(payload)
	end
	print(view_axes[key])
end

local function help_distribution(invocation)
	local selected = invocation == "nrandom" and "normal" or nil
	local flag_to_distribution = {
		["-n"] = "normal", ["--normalized"] = "normal",
		["--exponential"] = "exponential", ["--poisson"] = "poisson",
		["--log-normal"] = "log_normal", ["--beta"] = "beta",
	}
	for _, value in ipairs(argv) do
		local candidate = flag_to_distribution[value]
		if not candidate and value:match("^%-%-beta=") then candidate = "beta" end
		if candidate then
			if selected and selected ~= candidate then return nil end
			selected = candidate
		end
	end
	return selected
end

local function parse_range_literal(value)
	local first, last = value:match("^([+%-]?%d+)%.%.%.([+%-]?%d+)$")
	local exclusive = first ~= nil
	if not first then first, last = value:match("^([+%-]?%d+)%.%.([+%-]?%d+)$") end
	if not first then first, last = value:match("^([+%-]?%d+)%-([+%-]?%d+)$") end
	if not first then return nil end
	first = fx.parse_int_safe(first)
	last = fx.parse_int_safe(last)
	if first == nil or last == nil then return nil end
	return first, last, exclusive
end

local function print_help(invocation, distribution)
	print("Usage: " .. invocation .. " [options] [M-N|M..N|M...N]")
	print("       echo 'items' | " .. invocation .. " --choose")
	print("       echo 'items' | " .. invocation .. " --shuffle")
	print("")
	print("Cryptographically secure random generator with alternate distributions.")
	print("Seeded mode provides cross-platform-identical deterministic streams.")
	print("True-random mode uses fresh OS CSPRNG entropy; deterministic mode uses")
	print("a seeded BLAKE3 keyed XOF. A public seed is reproducible, not secret.")
	print("")
	print("Distributions (mutually exclusive):")
	print("  (default)           Uniform distribution")
	print("  -n, --normalized    Normal (Gaussian) via Box-Muller")
	print("      --exponential   Exponential distribution (use --rate)")
	print("      --poisson       Poisson distribution (use --lambda or --mean)")
	print("      --log-normal    Log-normal distribution")
	print("      --beta[=B]      Beta distribution; optional B replaces default beta 2")
	print("")
	print("Stdin operations:")
	print("      --choose        Pick one random item from stdin")
	print("      --shuffle       Shuffle all items from stdin")
	print("      --weighted      Pick from weighted stdin (format: value:weight)")
	print("")
	print("Options:")
	print("  -a, --about         Show a short description")
	print("  -b, --binaryoutput  Output binary bytes")
	print("  -c, --count N       Output N numbers (default: 1, or 1024 with -b)")
	print("  -d, --deterministic Use the cross-platform-identical BLAKE3 keyed XOF")
	print("      --true-random   Force fresh OS/source CSPRNG entropy; ignore DRANDOM_SEED")
	print("      --delimiter S   Set delimiter for output/input (default: newline)")
	print("  -h, --help          Show this help message")
	print("      --hex           Output as hexadecimal")
	print("      --base64        Output as base64 (for binary)")
	print("      --seed N|0xHEX  Set unsigned 256-bit integer seed (implies -d)")
	print("      --random-source PATH  Read entropy from PATH instead of the OS")
	print("      --no-wait       Fail rather than wait for Linux getrandom initialization")
	print("      --kitty         Force Kitty graphics for a distribution help chart")
	print("      --sixel         Force Sixel graphics for a distribution help chart")
	print("      --utf8           Force the UTF-8 Braille distribution chart")
	print("      --utf8-graphics  Long alias for --utf8")
	print("      --view          Show only the selected distribution with supplied parameters")
	print("      --mean M        Set mean for normal/log-normal; Poisson lambda alias")
	print("      --stddev S      Set stddev for normal/log-normal")
	print("      --rate R        Set exponential rate")
	print("      --lambda L      Set Poisson lambda (clearer alias for --mean)")
	print("      --alpha A       Set alpha for beta distribution")
	print("      --test          Run the test suite")
	print("")
	print("Symlink behavior:")
	print("  'nrandom' → implies --normalized")
	print("  'drandom' → implies --deterministic")
	print("")
	print("Environment variables:")
	print("  DRANDOM_SEED      Unsigned decimal or 0x-prefixed seed (implies -d)")
	print("  RANDOMZ_CHART_TYPE  utf8, kitty, or sixel; command-line flags override it")
	print("")
	print("Deterministic mode never persists state. Every invocation starts at")
	print("stream position zero. Without an explicit seed it obtains 32 bytes")
	print("from the entropy source and prints the replayable seed to stderr.")
	print("Seeded output, including alternate distributions, is byte-identical")
	print("across supported operating systems and CPU architectures.")
	print("")
	print("Examples:")
	print("  random                    # Uniform random 0-99")
	print("  random -n --mean 50 --stddev 10  # Normal, custom params")
	print("  random -d --seed 42       # Deterministic")
	print("  random --hex -c 5         # 5 hex numbers")
	print("  echo -e 'a\\nb\\nc' | random --choose")
	print("  echo 'rare:1,common:10' | random --weighted --delimiter ','")
	print_distribution_help(distribution)
end

-- ===== Stdin reading =====
local function read_stdin_items(delimiter)
	local content = io.read("*a")
	if not content or content == "" then return {} end
	content = trim(content)
	if content == "" then return {} end

	local items = {}
	if delimiter == "\n" then
		for line in content:gmatch("[^\n]+") do
			line = line:gsub("\r$", "")
			table.insert(items, line)
		end
	else
		for item in content:gmatch("[^" .. delimiter:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1") .. "]+") do
			table.insert(items, trim(item))
		end
	end
	return items
end

-- Fisher-Yates shuffle
local function shuffle_array(arr, rand_func)
	local n = #arr
	for i = n, 2, -1 do
		local j = rand_func(1, i)
		arr[i], arr[j] = arr[j], arr[i]
	end
	return arr
end

-- ===== Argument parsing =====
local function parse_args()
	local invocation = get_invocation_name()

	local options = {
		deterministic = (invocation == "drandom"),
		force_true_random = false,
		normalized = (invocation == "nrandom"),
		exponential = false,
		poisson = false,
		log_normal = false,
		beta = false,
		binary_output = false,
		hex_output = false,
		base64_output = false,
		delimiter = nil,  -- nil means use the default (always newline, never $IFS)
		choose = false,
		shuffle = false,
		weighted = false,
		count = nil,
		seed = nil,
		seed_provided = false,
		random_source = nil,
		no_wait = false,
		chart_renderer_flag = false,
		view = false,
		generation_option_seen = false,
		start_val = nil,
		end_val = nil,
		mean = nil,
		mean_text = nil,
		stddev = nil,
		stddev_text = nil,
		rate = nil,
		rate_text = nil,
		lambda = nil,
		lambda_text = nil,
		alpha = nil,
		alpha_text = nil,
		beta_param = nil,
		beta_param_text = nil,
	}

	local i = 1
	local positionals = {}

	while i <= #argv do
		local arg_val = argv[i]
		local attached_option, attached_value = arg_val:match("^(%-%-[%w%-]+)=(.*)$")
		if arg_val == "--about" or arg_val == "-a" then
			print_about(invocation)
			os.exit(0)
		elseif arg_val == "--help" or arg_val == "-h" then
			print_help(invocation, help_distribution(invocation))
			os.exit(0)
		elseif arg_val == "--test" then
			local self = (arg and arg[0]) or ""
			local self_dir = self:match("^(.*)/[^/]+$")
			local candidates = {}
			if os.getenv("RANDOM_TEST_FILE") then candidates[#candidates+1] = os.getenv("RANDOM_TEST_FILE") end
			if self_dir then candidates[#candidates+1] = self_dir .. "/../tests/random_test"; candidates[#candidates+1] = self_dir .. "/tests/random_test" end
			local test_file, f
			for _, p in ipairs(candidates) do local fh = io.open(p, "r"); if fh then test_file = p; f = fh; break end end
			if f then
				f:close()
				local cmd = "FAST=1 " .. shell_quote(test_file) .. " >/dev/null"
				local status = exec_status(cmd)
				os.exit(status)
			else
				stderr_write("Test file not found (searched RANDOM_TEST_FILE and executable-relative paths)\n")
				os.exit(1)
			end
		elseif arg_val == "--deterministic" or arg_val == "-d" then
			options.deterministic = true
			options.generation_option_seen = true
		elseif arg_val == "--true-random" then
			options.force_true_random = true
			options.generation_option_seen = true
		elseif arg_val == "--normalized" or arg_val == "-n" then
			options.normalized = true
		elseif arg_val == "--exponential" then
			options.exponential = true
		elseif arg_val == "--poisson" then
			options.poisson = true
		elseif arg_val == "--log-normal" then
			options.log_normal = true
		elseif arg_val == "--beta" or attached_option == "--beta" then
			options.beta = true
			local value = attached_value
			local bm, be
			if attached_option == "--beta" and value == "" then
				stderr_write("Error: --beta value must be a number\n")
				os.exit(1)
			end
			if not value and argv[i + 1] then
				local candidate = argv[i + 1]
				local cm, ce = fx.parse(candidate)
				local range_start = parse_range_literal(candidate)
				if cm or (candidate:sub(1, 1) ~= "-" and range_start == nil) then
					i = i + 1
					value, bm, be = candidate, cm, ce
				end
			end
			if value then
				if not bm then bm, be = fx.parse(value) end
				if not bm then
					stderr_write("Error: --beta value must be a number\n")
					os.exit(1)
				end
				if bm <= 0 then
					stderr_write("Error: --beta parameter must be positive\n")
					os.exit(1)
				end
				options.beta_param = { bm, be }
				options.beta_param_text = value
			end
		elseif arg_val == "--binaryoutput" or arg_val == "-b" then
			options.binary_output = true
			options.generation_option_seen = true
		elseif arg_val == "--hex" then
			options.hex_output = true
			options.generation_option_seen = true
		elseif arg_val == "--base64" then
			options.base64_output = true
			options.generation_option_seen = true
		elseif arg_val == "--choose" then
			options.choose = true
			options.generation_option_seen = true
		elseif arg_val == "--shuffle" then
			options.shuffle = true
			options.generation_option_seen = true
		elseif arg_val == "--weighted" then
			options.weighted = true
			options.generation_option_seen = true
		elseif arg_val == "--no-wait" then
			options.no_wait = true
			options.generation_option_seen = true
		elseif arg_val == "--view" then
			options.view = true
		elseif arg_val == "--kitty" or arg_val == "--sixel" or
			arg_val == "--utf8" or arg_val == "--utf8-graphics" then
			options.chart_renderer_flag = true
		elseif arg_val:match("^%-%-random%-source=") then
			options.generation_option_seen = true
			options.random_source = arg_val:sub(#"--random-source=" + 1)
			if options.random_source == "" then
				stderr_write("Error: --random-source requires a path\n")
				os.exit(1)
			end
		elseif arg_val == "--random-source" then
			options.generation_option_seen = true
			i = i + 1
			if i > #argv or argv[i] == "" then
				stderr_write("Error: --random-source requires a path\n")
				os.exit(1)
			end
			options.random_source = argv[i]
		elseif arg_val == "--delimiter" or arg_val == "--delim" then
			options.generation_option_seen = true
			i = i + 1
			if i > #argv then
				stderr_write("Error: --delimiter requires a value\n")
				os.exit(1)
			end
			if argv[i] == "" then
				stderr_write("Error: --delimiter must not be empty\n")
				os.exit(1)
			end
			options.delimiter = argv[i]
		elseif arg_val == "--count" or arg_val == "-c" then
			options.generation_option_seen = true
			i = i + 1
			if i > #argv then
				stderr_write("Error: --count requires a number\n")
				os.exit(1)
			end
			options.count = fx.parse_int_safe(argv[i])
			if not options.count or options.count < 0 then
				stderr_write("Error: --count must be a nonnegative whole number no larger than 2^53\n")
				os.exit(1)
			end
		elseif arg_val == "--seed" then
			options.generation_option_seen = true
			i = i + 1
			if i > #argv then
				stderr_write("Error: --seed requires a value\n")
				os.exit(1)
			end
			options.seed = parse_seed(argv[i])
			if options.seed == nil then
				stderr_write("Error: --seed must be an unsigned decimal or " ..
					"0x-prefixed hexadecimal integer smaller than 2^256, got: " ..
					argv[i] .. "\n")
				os.exit(1)
			end
			options.seed_provided = true
			options.deterministic = true
		elseif arg_val == "--mean" or attached_option == "--mean" then
			local value = attached_value
			if not value then i = i + 1; value = argv[i] end
			if not value or value == "" then
				stderr_write("Error: --mean requires a number\n")
				os.exit(1)
			end
			local mm, me = fx.parse(value)
			if not mm then
				stderr_write("Error: --mean value must be a number\n")
				os.exit(1)
			end
			options.mean = { mm, me }
			options.mean_text = value
		elseif arg_val == "--stddev" or attached_option == "--stddev" then
			local value = attached_value
			if not value then i = i + 1; value = argv[i] end
			if not value or value == "" then
				stderr_write("Error: --stddev requires a number\n")
				os.exit(1)
			end
			local sm, se = fx.parse(value)
			if not sm then
				stderr_write("Error: --stddev value must be a number\n")
				os.exit(1)
			end
			if sm <= 0 then
				stderr_write("Error: --stddev must be positive\n")
				os.exit(1)
			end
			options.stddev = { sm, se }
			options.stddev_text = value
		elseif arg_val == "--rate" or attached_option == "--rate" then
			local value = attached_value
			if not value then i = i + 1; value = argv[i] end
			if not value or value == "" then
				stderr_write("Error: --rate requires a number\n")
				os.exit(1)
			end
			local rm, re = fx.parse(value)
			if not rm then
				stderr_write("Error: --rate value must be a number\n")
				os.exit(1)
			end
			if rm <= 0 then
				stderr_write("Error: --rate must be positive\n")
				os.exit(1)
			end
			options.rate = { rm, re }
			options.rate_text = value
		elseif arg_val == "--lambda" or attached_option == "--lambda" then
			local value = attached_value
			if not value then i = i + 1; value = argv[i] end
			if not value or value == "" then
				stderr_write("Error: --lambda requires a number\n")
				os.exit(1)
			end
			local lm, le = fx.parse(value)
			if not lm then
				stderr_write("Error: --lambda value must be a number\n")
				os.exit(1)
			end
			if lm <= 0 then
				stderr_write("Error: --lambda must be positive\n")
				os.exit(1)
			end
			options.lambda = { lm, le }
			options.lambda_text = value
		elseif arg_val == "--alpha" or attached_option == "--alpha" then
			local value = attached_value
			if not value then i = i + 1; value = argv[i] end
			if not value or value == "" then
				stderr_write("Error: --alpha requires a number\n")
				os.exit(1)
			end
			local am, ae = fx.parse(value)
			if not am then
				stderr_write("Error: --alpha value must be a number\n")
				os.exit(1)
			end
			if am <= 0 then
				stderr_write("Error: --alpha must be positive\n")
				os.exit(1)
			end
			options.alpha = { am, ae }
			options.alpha_text = value
		else
			if arg_val:sub(1, 2) == "--" then
				stderr_write("Error: unknown option: " .. arg_val .. "\n")
				os.exit(1)
			end
			table.insert(positionals, arg_val)
		end
		i = i + 1
	end

	if options.view and #positionals > 0 then
		stderr_write("Error: --view does not accept a range\n")
		os.exit(1)
	end
	if #positionals > 1 then
		stderr_write("Error: expected at most one range (M-N, M..N, or M...N)\n")
		os.exit(1)
	end
	if #positionals > 0 and (options.exponential or options.poisson or
		options.log_normal or options.beta) then
		stderr_write("Error: ranges do not apply to the selected distribution\n")
		os.exit(1)
	end
	if #positionals > 0 and options.normalized and (options.mean or options.stddev) then
		stderr_write("Error: a range cannot be combined with custom normal parameters\n")
		os.exit(1)
	end

	-- Parse the one atomic range argument. Two dots and hyphen are inclusive;
	-- three dots follow Ruby's end-exclusive convention.
	if #positionals == 1 then
		-- fx.parse_int_safe, not fx.parse_int: the latter's documented
		-- contract silently double-rounds any magnitude past 2^53 --
		-- fine for --count (a loop bound), NOT fine for a range bound,
		-- where the value used must be the value asked for. Confirmed
		-- directly: `random --seed 1 9007199254740993-9007199254740993
		-- -c 1` used to print 9007199254740992 (2^53+1 silently
		-- collapsed to 2^53) with fx.parse_int here. See
		-- fx.parse_int_safe's own doc comment in lib/fixed.lua for the
		-- full rationale, including why full int64-exact bounds were
		-- deliberately not chosen instead.
		local start_val, end_val, exclusive = parse_range_literal(positionals[1])
		if start_val == nil then
			stderr_write("Error: range must be M-N, M..N, or M...N using whole numbers no larger than 2^53 in magnitude\n")
			os.exit(1)
		end
		if exclusive then
			if start_val >= end_val then
				stderr_write("Error: an end-exclusive range must have M < N\n")
				os.exit(1)
			end
			end_val = end_val - 1
		end
		options.start_val, options.end_val = start_val, end_val
	end

	-- Validate: only one distribution type
	local dist_count = 0
	if options.normalized then dist_count = dist_count + 1 end
	if options.exponential then dist_count = dist_count + 1 end
	if options.poisson then dist_count = dist_count + 1 end
	if options.log_normal then dist_count = dist_count + 1 end
	if options.beta then dist_count = dist_count + 1 end
	if options.chart_renderer_flag and not options.view then
		stderr_write("Error: --kitty, --sixel, --utf8, and --utf8-graphics require --help or --view\n")
		os.exit(1)
	end
	if dist_count > 1 then
		stderr_write("Error: only one distribution type can be specified\n")
		os.exit(1)
	end
	if options.view and dist_count ~= 1 then
		stderr_write("Error: --view requires exactly one alternate distribution\n")
		os.exit(1)
	end
	if options.view and options.generation_option_seen then
		stderr_write("Error: --view cannot be combined with generation, stdin, range, or output options\n")
		os.exit(1)
	end
	local stdin_modes = (options.choose and 1 or 0) + (options.shuffle and 1 or 0) +
		(options.weighted and 1 or 0)
	if stdin_modes > 1 then
		stderr_write("Error: only one stdin operation can be specified\n")
		os.exit(1)
	end
	if options.base64_output and not options.binary_output then
		stderr_write("Error: --base64 requires --binaryoutput\n")
		os.exit(1)
	end
	if options.hex_output and options.base64_output then
		stderr_write("Error: --hex and --base64 are mutually exclusive\n")
		os.exit(1)
	end
	if options.mean and not (options.normalized or options.poisson or options.log_normal) then
		stderr_write("Error: --mean is not used by the selected distribution\n")
		os.exit(1)
	end
	if options.stddev and not (options.normalized or options.log_normal) then
		stderr_write("Error: --stddev is not used by the selected distribution\n")
		os.exit(1)
	end
	if options.rate and not options.exponential then
		stderr_write("Error: --rate requires --exponential\n")
		os.exit(1)
	end
	if options.lambda and not options.poisson then
		stderr_write("Error: --lambda requires --poisson\n")
		os.exit(1)
	end
	if options.poisson and options.lambda and options.mean then
		stderr_write("Error: --lambda and --mean are aliases; specify only one\n")
		os.exit(1)
	end
	if options.alpha and not options.beta then
		stderr_write("Error: --alpha requires --beta\n")
		os.exit(1)
	end

	-- --mean is the poisson rate parameter (lambda), undefined at <= 0 --
	-- but shared with --normalized/--log-normal, where negative and zero
	-- ARE valid means (see tests/random_test's negative-mean coverage),
	-- so this check has to be conditional on the ACTIVE distribution
	-- rather than a blanket rule on --mean itself. mean is a soft-float,
	-- not a Lua number, so this is a direct mantissa-sign check (the
	-- same convention used at every --alpha/--beta/--stddev check
	-- above and at MIN_UNIFORM's zero-draw substitution near the top of
	-- this file), not fx.cmp against a constructed zero.
	if options.poisson and options.mean and options.mean[1] <= 0 then
		stderr_write("Error: --mean must be positive for --poisson (it is the rate parameter)\n")
		os.exit(1)
	end

	-- Default delimiter is always newline, regardless of $IFS. A seeded
	-- stream must not depend on an ambient shell variable -- $IFS also
	-- governed stdin tokenization (--choose/--shuffle/--weighted) via
	-- this same default, so an exported $IFS silently selected a
	-- DIFFERENT item from the SAME stdin at the SAME seed. Confirmed
	-- directly: `env IFS=, random --seed 42 -c 3` printed "26,9,35"
	-- while `env -u IFS random --seed 42 -c 3` printed "26\n9\n35" --
	-- same seed, same arguments, different bytes. --delimiter remains
	-- the explicit, documented control for anyone who wants something
	-- else.
	if options.delimiter == nil then
		options.delimiter = "\n"
	end

	if options.force_true_random and options.deterministic then
		stderr_write("Error: --true-random cannot be combined with --deterministic, --seed, or drandom\n")
		os.exit(1)
	end

	-- DRANDOM_SEED implies deterministic mode, just like --seed. The value
	-- is parsed in main so a malformed environment value fails explicitly.
	if not options.force_true_random and not options.deterministic then
		local env_seed_raw = os.getenv("DRANDOM_SEED")
		if env_seed_raw and env_seed_raw ~= "" then
			options.deterministic = true
		end
	end

	return options, positionals, invocation
end

-- ===== Main =====
local function main()
	local options, positionals, invocation = parse_args()
	if options.view then
		print_distribution_view(options)
		return
	end

	-- Setup RNG first (needed for all operations). Entropy readers are kept
	-- open for the invocation and always fail closed on short reads/errors.
	local rand_func, uniform_func, entropy_reader

	if options.deterministic then
		local env_seed_raw = os.getenv("DRANDOM_SEED")
		local env_seed_set = env_seed_raw ~= nil and env_seed_raw ~= ""
		local seed_material

		if options.seed_provided then
			seed_material = options.seed
		elseif env_seed_set then
			seed_material = parse_seed(env_seed_raw)
			if seed_material == nil then
				stderr_write("Error: DRANDOM_SEED must be an unsigned decimal or " ..
					"0x-prefixed hexadecimal integer smaller than 2^256, got: " ..
					env_seed_raw .. "\n")
				os.exit(1)
			end
		else
			entropy_reader = make_entropy_reader(options.random_source, options.no_wait)
			seed_material = entropy_reader(32)
			stderr_write("(seed: 0x" .. bytes_to_hex(seed_material) .. ")\n")
		end

		drbg_seed(seed_material)
		rand_func = drbg_range
		uniform_func = drbg_uniform
	else
		entropy_reader = make_entropy_reader(options.random_source, options.no_wait)
		rand_func = function(start_val, end_val)
			return true_random_range(start_val, end_val, entropy_reader)
		end
		uniform_func = function() return true_random_uniform(entropy_reader) end
	end

	-- Handle stdin operations
	if options.choose then
		local items = read_stdin_items(options.delimiter)
		if #items == 0 then
			stderr_write("Error: no items to choose from\n")
			os.exit(1)
		end
		local idx = rand_func(1, #items)
		print(items[idx])
		return
	end

	if options.shuffle then
		local items = read_stdin_items(options.delimiter)
		if #items == 0 then
			stderr_write("Error: no items to shuffle\n")
			os.exit(1)
		end
		shuffle_array(items, rand_func)
		for _, item in ipairs(items) do
			print(item)
		end
		return
	end

	if options.weighted then
		local items = read_stdin_items(options.delimiter)
		if #items == 0 then
			stderr_write("Error: no items for weighted selection\n")
			os.exit(1)
		end

		local weighted_items = {}
		local total_weight = 0
		for _, item in ipairs(items) do
			local value, weight = item:match("^(.+):(%d+)$")
			if not value or not weight then
				stderr_write("Error: weighted item must be in format 'value:weight', got: " .. item .. "\n")
				os.exit(1)
			end
			-- fx.parse_int_safe, not tonumber: the regex above only lets
			-- through unsigned digit strings, but tonumber() on a long
			-- enough one still silently loses precision (or, past
			-- double's own range, returns inf) rather than rejecting --
			-- confirmed directly: a 28-digit weight fed into the old
			-- range sampler as total_weight produced undefined downstream
			-- behavior (observed as both an infinite hang and silent
			-- wrong output, depending on how the old sampler's FFI
			-- double-to-u64 cast happened to land). Same fix,
			-- same rationale, as the range-bound fix this call site's
			-- comment neighbors (see fx.parse_int_safe's own doc
			-- comment in lib/fixed.lua).
			weight = fx.parse_int_safe(weight)
			if weight == nil then
				stderr_write("Error: weighted item weight is out of range (must be a " ..
					"whole number no larger than 2^53): " .. item .. "\n")
				os.exit(1)
			end
			if weight > MAX_EXACT_INTEGER - total_weight then
				stderr_write("Error: total weighted-item weight must be no larger than 2^53\n")
				os.exit(1)
			end
			table.insert(weighted_items, {value = value, weight = weight})
			total_weight = total_weight + weight
		end
		if total_weight == 0 then
			stderr_write("Error: total weighted-item weight must be positive\n")
			os.exit(1)
		end

		local pick = rand_func(1, total_weight)
		local cumulative = 0
		for _, wi in ipairs(weighted_items) do
			cumulative = cumulative + wi.weight
			if pick <= cumulative then
				print(wi.value)
				break
			end
		end

		return
	end

	-- Regular number generation
	local start_val, end_val, count
	local show_defaults_msg = false

	if options.binary_output then
		start_val = options.start_val or 0
		end_val = options.end_val or 255
		count = options.count or 1024

		if start_val < 0 then
			stderr_write("Error: start value must be >= 0 for binary output\n")
			os.exit(1)
		end
		if end_val > 255 then
			stderr_write("Error: end value must be <= 255 for binary output\n")
			os.exit(1)
		end
	else
		local range_scaled = not (options.exponential or options.poisson or
			options.log_normal or options.beta) and not
			(options.normalized and (options.mean or options.stddev))
		if options.start_val == nil and options.end_val == nil and range_scaled then
			show_defaults_msg = true
		end
		start_val = options.start_val or 0
		end_val = options.end_val or 99
		count = options.count or 1
	end

	-- Validate range for integer distributions
	if not (options.exponential or options.poisson or options.log_normal or options.beta) then
		if start_val > end_val then
			stderr_write("Error: start value must be less than or equal to end value\n")
			os.exit(1)
		end
		-- Both endpoints may individually be exact Lua integers while their
		-- inclusive span is not (for example -2^53..2^53). Sampling that
		-- rounded span would silently omit or bias values.
		if end_val - start_val >= MAX_EXACT_INTEGER then
			stderr_write("Error: an inclusive integer range may contain at most 2^53 values\n")
			os.exit(1)
		end
	end

	if show_defaults_msg and not options.binary_output then
		stderr_write("(with the default range 0..99)\n")
	end

	-- Generate values. Each value is either a plain Lua integer (uniform,
	-- --normalized, --poisson -- all produced by rand_func/to_int_trunc
	-- already applied below) or a 2-element {m, e} soft-float table
	-- (--exponential, --log-normal, --beta) -- the shape distinguishes the
	-- two cases downstream, so no separate is-integer flag is needed.
	local values = {}
	local binary_data = {}
	local has_distribution = options.normalized or options.exponential or
		options.poisson or options.log_normal or options.beta
	local direct_binary = options.binary_output and not has_distribution and
		start_val == 0 and end_val == 255

	if direct_binary then
		binary_data[1] = options.deterministic and drbg_draw_bytes(count) or
			entropy_reader(count)
	end

	for _ = 1, direct_binary and 0 or count do
		local value

		if options.exponential then
			local rm, re = ONE_M, ONE_E
			if options.rate then rm, re = options.rate[1], options.rate[2] end
			value = { exponential_random(rm, re, uniform_func) }
		elseif options.poisson then
			local lm, le = ONE_M, ONE_E
			local lambda = options.lambda or options.mean
			if lambda then lm, le = lambda[1], lambda[2] end
			value = poisson_random(lm, le, uniform_func)
		elseif options.log_normal then
			local mum, mue = 0LL, 0
			if options.mean then mum, mue = options.mean[1], options.mean[2] end
			local sdm, sde = ONE_M, ONE_E
			if options.stddev then sdm, sde = options.stddev[1], options.stddev[2] end
			value = { lognormal_random(mum, mue, sdm, sde, uniform_func) }
		elseif options.beta then
			local am, ae = TWO_M, TWO_E
			if options.alpha then am, ae = options.alpha[1], options.alpha[2] end
			local bm, be = TWO_M, TWO_E
			if options.beta_param then bm, be = options.beta_param[1], options.beta_param[2] end
			value = { beta_random(am, ae, bm, be, uniform_func) }
		elseif options.normalized then
			if options.mean or options.stddev then
				-- Use custom mean/stddev, output as an int rounded to
				-- nearest via round_to_int (sign-aware -- see its own doc
				-- comment for why a plain "add 1/2, truncate toward zero"
				-- is wrong for negative results).
				local mum, mue = 0LL, 0
				if options.mean then mum, mue = options.mean[1], options.mean[2] end
				local sdm, sde = ONE_M, ONE_E
				if options.stddev then sdm, sde = options.stddev[1], options.stddev[2] end
				local vm, ve = normal_random_float(mum, mue, sdm, sde, uniform_func)
				value = round_to_int(vm, ve)
			else
				value = normal_random_int(start_val, end_val, rand_func)
			end
		else
			value = rand_func(start_val, end_val)
		end

		if options.binary_output then
			local byte_val
			if type(value) == "table" then
				byte_val = fx.to_int_trunc(value[1], value[2])
			else
				byte_val = value
			end
			table.insert(binary_data, string.char(byte_val % 256))
		else
			table.insert(values, value)
		end
	end

	-- Output
	if options.binary_output then
		local data = table.concat(binary_data)
		if options.base64_output then
			print(base64_encode(data))
		elseif options.hex_output then
			local hex = {}
			for i = 1, #data do
				hex[i] = string.format("%02x", string.byte(data, i))
			end
			print(table.concat(hex))
		else
			io.stdout:write(data)
		end
	else
		local output_delimiter = options.delimiter
		if options.hex_output then
			for i, v in ipairs(values) do
				if i > 1 and output_delimiter ~= "\n" then
					io.stdout:write(output_delimiter)
				end
				local formatted
				if type(v) == "number" then
					formatted = string.format("%x", v)
				else
					formatted = fx.tostring(v[1], v[2], 6)
				end
				if output_delimiter == "\n" then
					print(formatted)
				else
					io.stdout:write(formatted)
				end
			end
			if output_delimiter ~= "\n" then
				print("")
			end
		else
			for i, v in ipairs(values) do
				if i > 1 and output_delimiter ~= "\n" then
					io.stdout:write(output_delimiter)
				end
				local formatted
				if type(v) == "number" then
					-- Not plain tostring(v): Lua's default %.14g formatting
					-- switches to scientific notation once an
					-- integer-valued double's magnitude reaches ~1e14 --
					-- the same defect lib/fixed.lua's M.tostring used to
					-- have on its own output path (see that function's own
					-- doc comment). Fixed the SAME way M.tostring itself
					-- now is: route through fx.tostring's exact
					-- digit-extraction rather than a floating-point-style
					-- format specifier -- this file's own "no libm calls"
					-- CLI test greps bin/random for exactly that shape of
					-- specifier (a real determinism guard: formatting a
					-- genuinely fractional value that way is
					-- platform-dependent in its last digit), so this stays
					-- clean of it too, not just clean of scientific
					-- notation.
					local vfm, vfe = fx.from_int(v)
					formatted = fx.tostring(vfm, vfe, 0)
				else
					formatted = fx.tostring(v[1], v[2], 6)
				end
				if output_delimiter == "\n" then
					print(formatted)
				else
					io.stdout:write(formatted)
				end
			end
			if output_delimiter ~= "\n" then
				print("")
			end
		end
	end

end

main()
