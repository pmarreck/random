# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
open=[
	bin
	lib
	tests
]

annotate=[
	ZIG_0.15_TO_0.16_MIGRATION.md = Symlink to the canonical Zig 0.15->0.16 migration guide (Io interface, Juicy Main); more current than ZIG_RECENT_API_CHANGES.md on the I/O rework
	ZIG_RECENT_API_CHANGES.md = Symlink to the canonical Zig 0.16 API-changes cheatsheet in the Obsidian vault; read before writing build code
	bin/random = unified random CLI; distributions/parsing/output run entirely through lib/fixed.lua's integer kernel (no math.*, no tonumber, no %f)
	build.zig = Zig build: ReleaseFast default for artifacts, ReleaseSafe for tests; fixed module + differential driver
	build.zig.zon = Zig package manifest (no dependencies, deliberately -- keeps the Nix sandbox build network-free)
	crossarch = top-level runner for the cross-architecture differential (not part of ./test)
	docs/cross-architecture-evidence.md = recorded evidence + digests for the cross-architecture determinism claim, incl. mutation results and caveats
	docs/luajit-bug-report-DRAFT.md = Draft LuaJIT issue report (awaiting Peter's review before filing)
	docs/luajit-bug-report.md = Filed LuaJIT issue #1499 plus the pre-filing critique record
	docs/luajit-div-miscompilation.lua = Minimal standalone repro of a LuaJIT 2.1.1774638290 trace-compiler miscompilation found while building the kernel; exits non-zero when miscompiled
	docs/luajit-ir-with-fwd.txt = IR dump (-jdump=i -O2 -O+fwd): the miscompiling build
	docs/luajit-ir-without-fwd.txt = IR dump (-jdump=i -O3 -O-fwd): the correct build, for diffing
	docs/plans/2026-08-01-deterministic-numeric-kernel.md = Implementation plan, spec steps 1-4: pcg32_range fix, integer goldens, soft-float kernel, LuaJIT conversion
	docs/plans/2026-08-02-zig-port.md = Zig port implementation plan: kernel -> C FFI -> randomz CLI, differential-tested against bin/random
	docs/research/2026-08-04-pure-lua-blake3-evaluation.md = differential of a pure-Lua BLAKE3 gist vs Zig stdlib (246/246 official-methodology vectors, seek verified, 346 MB/s); blocked on licensing
	docs/specs/2026-07-31-deterministic-fixed-point-rng-design.md = Design spec: integer-only Q32.32+soft-float RNG kernel for cross-platform bit-identical seeded streams; Zig/FFI port plan
	lib/fixed.lua = integer-only soft-float kernel (mul/add/sub/neg/cmp/norm/from_int/frac/div/ln/exp/cos_turns/sqrt/pow/parse/parse_int/tostring); replaces libm and strtod/%f for cross-platform reproducibility. M.norm and div_signed both need jit.off (LuaJIT/LuaJIT#1499)
	src/differential_driver.zig = TEST driver printing the Zig kernel's swept results for comparison against lib/fixed.lua; NOT the CLI (that is C, Task 9)
	src/fixed.zig = Zig port of the integer-only soft-float kernel (pure, no I/O); Task 1: norm + fromInt
	tests/bless-goldens = Regenerates golden vectors; run deliberately, never from ./test
	tests/cross_arch_controls.lua = positive controls that MUST diverge: platform libm (libc axis) and out-of-range double->int (architecture axis)
	tests/cross_arch_decimal.lua = payload: per-function digests for parse/tostring/parse_int/from_int/to_int_trunc/frac/cmp/mul128 (the surface kernel_jit_diff.lua does not cover)
	tests/cross_arch_diff = cross-arch/libc differential: kernel+decimal+CLI payloads across x86_64-glibc/musl/aarch64(+optional native remote), with liveness/reflexivity/sensitivity self-controls
	tests/fixed_test = Bash entrypoint: execs fixed_test.lua under luajit
	tests/fixed_test.lua = fast pure-Lua unit tests for lib/fixed.lua: exactness pins, precondition/assert coverage, oracle-free metamorphic ln checks, decimal parse/format round-trip
	tests/golden = Committed golden vectors: integer.txt (pre-conversion), dist.txt (post-conversion)
	tests/golden_test = Regenerates each golden set into a temp file via bless-goldens and diffs against the committed one; fails if none found
	tests/kernel_bc_sweep = bash entrypoint: sweeps fixed.lua div/ln against bc -l as an independent arbitrary-precision oracle
	tests/kernel_bc_sweep.lua = generates the bc program + parses results for the div/ln/exp/cos/sqrt/pow/tostring sweep; a Lua-double comparison cannot validate this kernel's ~2^-62 precision claim
	tests/kernel_jit_diff = bash entrypoint: diffs the whole kernel's output under luajit vs luajit -joff, a differential control for LuaJIT/LuaJIT#1499-class trace-compiler miscompilations
	tests/kernel_jit_diff.lua = deterministic whole-kernel digest (mul/div/add/sub/norm/ln/exp/cos_turns/sqrt/pow, mixed-sign) run twice by kernel_jit_diff and compared byte-for-byte
	tests/random_test = CLI behavior + statistical distribution tests for bin/random; Test 45 asserts no libm/tonumber(argv)/%f calls remain
	tests/zig_differential = differential control: src/fixed.zig vs lib/fixed.lua, bit-exact, with liveness guards
	tests/zig_differential.lua = LuaJIT oracle half of the Zig differential; walks the identical operand sweep
]
