#!/usr/bin/env bash
# Build the whole project via `nix build` (sandboxed, deterministic -- avoids
# host OS detection issues) and expose the binaries at a stable path.
#
# `result/` is a symlink into the read-only nix store whose target changes on
# every rebuild, so we also copy the CLIs into `zig-out/bin/` (gitignored) for
# stable, writable `random`, `randomz`, and `randomr` paths.
#
# Usage: ./build                 # ReleaseFast, all optimizations (default)
#        ./build --print-build-logs   # any extra args pass through to `nix build`
#
# NOTE: no `set -e` -- we branch on nix's exit status explicitly so we can emit
# a useful message rather than aborting silently.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here" || exit 1

# The flake's package runs `zig build -Doptimize=ReleaseFast` and installs both
# the LuaJIT `random`, Zig/C `randomz`, and Rust `randomr` CLIs.
# Use a path flake so a pre-commit worktree includes newly created source files.
# Git-flake semantics hide untracked files, making the build unable to validate
# a new crate (or any other new file) until it has already been staged.
nix build path:.#default "$@"
rc=$?
if [ "$rc" -ne 0 ]; then
	echo "build FAILED (nix build exited $rc)" >&2
	exit "$rc"
fi

mkdir -p zig-out/bin zig-out/lib
# `result/bin/*` are mode-555 store files; install -m755 gives writable copies.
install -m755 result/bin/randomz zig-out/bin/randomz
install -m755 result/bin/random  zig-out/bin/random
install -m755 result/bin/randomr zig-out/bin/randomr
# `randomr` is wrapped only to make its installed `--test` self-contained.
# Benchmarks use the identical unwrapped ELF so Nix's Bash/PATH setup is not
# charged to Rust's deterministic core on every measured invocation.
install -m755 result/libexec/randomr zig-out/bin/.randomr-bench
# The LuaJIT frontend resolves these relative to its copied executable.
install -m644 result/lib/blake3.lua             zig-out/lib/blake3.lua
install -m644 result/lib/fixed.lua              zig-out/lib/fixed.lua
install -m644 result/lib/distribution_charts.lua zig-out/lib/distribution_charts.lua
install -m644 result/lib/distribution_view.lua   zig-out/lib/distribution_view.lua
install -m644 result/lib/state_json.lua          zig-out/lib/state_json.lua

echo "Built:"
echo "  $here/zig-out/bin/randomz   ($("$here/zig-out/bin/randomz" --about 2>/dev/null))"
echo "  $here/zig-out/bin/random    (LuaJIT frontend)"
echo "  $here/zig-out/bin/randomr   ($("$here/zig-out/bin/randomr" --about 2>/dev/null))"
