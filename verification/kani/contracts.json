{
	"templates": {
		"range": {
			"unwind": 3,
			"assertions": ["range exact reduction", "range rejection consumption", "range output bounded", "range equal preimage certificate"],
			"negative": "range exact reduction",
			"covers": ["range zero accepted reachable", "range cutoff endpoint reachable", "range last residue reachable"],
			"scope": "All words and valid i64 start offsets at one named cardinality; at most one rejection then an accepted zero word. Word-interface abstraction; no BLAKE3/byte-endian/source-error proof. Equal-preimage certificate assumes a uniform primitive word."
		},
		"division": {
			"unwind": 2,
			"assertions": ["division exponent acceptance", "division result canonical", "division sign restored", "division exponent restored", "division normalization even", "division quotient certificate", "division overflow typed"],
			"negative": "division quotient certificate",
			"covers": ["division minimum numerator reachable", "division maximum numerator reachable", "division positive success reachable", "division negative success reachable", "division overflow reachable"],
			"scope": "Every canonical nonzero numerator, both signs and all i32 exponents; one named nonzero normalized divisor magnitude. Independent widened quotient certificate; not all denominator magnitudes."
		}
	},
	"harnesses": [
		{
			"id": "kani_proofs::fixed_parts_contract", "function": "kani_proofs::fixed_parts_contract", "unwind": 2,
			"assertions": ["canonical acceptance contract", "accepted parts preserved", "accepted value canonical"],
			"negative": "canonical acceptance contract",
			"covers": ["canonical zero reachable", "negative canonical endpoint reachable", "positive canonical endpoint reachable", "rejected minimum mantissa reachable", "noncanonical zero reachable"],
			"scope": "All i64 mantissas and i32 exponents; no assumptions/stubs."
		},
		{
			"id": "kani_proofs::negation_contract", "function": "kani_proofs::negation_contract", "unwind": 2,
			"assertions": ["negation stays canonical", "negation reverses sign exactly", "negation preserves exponent", "double negation identity"],
			"negative": "double negation identity",
			"covers": ["negation zero reachable", "negation negative endpoint reachable", "negation positive endpoint reachable"],
			"scope": "All canonical values, including zero and all i32 exponents."
		},
		{
			"id": "kani_proofs::addition_subtraction_closure_contract", "function": "kani_proofs::addition_subtraction_closure_contract", "unwind": 2,
			"assertions": ["add subtract result canonical", "add subtract overflow typed", "add subtract safe exponents succeed", "addition zero identity"],
			"negative": "addition zero identity",
			"covers": ["subtraction cancellation reachable", "addition overflow reachable", "addition subtraction safe success reachable"],
			"scope": "All canonical operand pairs and all i32 exponents; successful outputs satisfy an independent canonical predicate. Success required for exponents [-1000,1000]. Does not claim exact real addition."
		},
		{
			"id": "kani_proofs::multiplication_unit_mantissa_contract", "function": "kani_proofs::multiplication_named::<4611686018427387904>", "unwind": 2,
			"assertions": ["multiply exponent acceptance", "multiply overflow typed", "multiply result canonical", "multiply exponent restored", "multiply sign restored", "multiply exact mantissa"],
			"negative": "multiply exact mantissa",
			"covers": ["multiply zero reachable", "multiply low normalization reachable", "multiply overflow reachable"],
			"unreachable_covers": ["multiply high normalization reachable"],
			"scope": "First magnitude 2^62, both signs, every canonical second operand and all i32 exponents; exact truncated product. Not all first magnitudes."
		},
		{
			"id": "kani_proofs::multiplication_incremented_unit_contract", "function": "kani_proofs::multiplication_named::<4611686018427387905>", "unwind": 2,
			"assertions": ["multiply exponent acceptance", "multiply overflow typed", "multiply result canonical", "multiply exponent restored", "multiply sign restored", "multiply exact mantissa"],
			"negative": "multiply exact mantissa",
			"covers": ["multiply zero reachable", "multiply high normalization reachable", "multiply low normalization reachable", "multiply overflow reachable"],
			"scope": "First magnitude 2^62+1, both signs, every canonical second operand and all i32 exponents; exact truncated product. High branch occurs only at second magnitude i64::MAX. Other first magnitudes, including i64::MAX, remain unproved."
		},
		{
			"id": "kani_proofs::division_pow2_contract", "function": "kani_proofs::division_named::<4611686018427387904>", "template": "division", "divisor": "4611686018427387904", "unreachable_covers": ["division normalization shift reachable"]
