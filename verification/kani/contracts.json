			"guards": [{"function": "drbg::fill_xof", "description": "XOF unreachable on preflight error"}, {"function": "<[u8; 1024] as zeroize::Zeroize>::zeroize", "description": "cache erasure unreachable on read contract"}],
			"scope": "Read lengths 1..8 crossing the cap, every valid initial cursor and arbitrary backing state; symbolic byte indices quantify unchanged key/cache. XOF and cache erasure replaced by forbidden-call assertions, which must be unreachable."
