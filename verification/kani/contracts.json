			"stubs": [{"original": "zeroize::optimization_barrier", "replacement": "compiler_barrier"}],
			"scope": "Every key/cache/cache metadata, valid initial cursor and requested u64 cursor. Symbolic byte index quantifies over every cache byte. Actual cache erasure writes retained; compiler retention/drop-time erasure excluded."
