			"stubs": [{"original": "zeroize::optimization_barrier", "replacement": "compiler_barrier"}, {"original": "super::fill_xof", "replacement": "forbidden_xof"}, {"original": "<[u8;1024]aszeroize::Zeroize>::zeroize", "replacement": "forbidden_array_erasure"}],
			"guards": [{"function": "drbg::fill_xof", "description": "XOF unreachable on preflight error"}, {"function": "<[u8; 1024] as zeroize::Zeroize>::zeroize", "description": "cache erasure unreachable on read contract"}],
			"scope": "Read lengths 0..8 wholly inside coherent cached spans; symbolic backing bytes, no cache-content/BLAKE3 correctness claim. Refills and erasure must be unreachable."
		},
		{
			"id": "batch::kani_contracts::portable_wrapper_contract", "function": "batch::kani_contracts::portable_wrapper_contract", "unwind": 33,
			"assertions": ["batch typed prefix result", "batch scalar source consumption", "batch initialized prefix untouched tail"], "negative": "batch initialized prefix untouched tail",
			"covers": ["batch empty reachable", "batch four successes reachable", "batch partial failure reachable", "batch immediate failure reachable"],
			"stubs": [{"original": "crate::batch::sample_prepared", "replacement": "modeled_scalar"}, {"original": "crate::ziggurat::normal", "replacement": "forbidden_normal"}],
			"scope": "0..4 output lanes and arbitrary scalar results/first-error positions, range 0..20. Production portable wrapper and cached parameter kernel; prepared scalar sampler replaced by explicit one-word/error model. The forbidden nonlinear stub is outside the accepted assertion set: Kani elides it when disconnected, and any emitted guard rejects stale/bypassed boundaries. No nonlinear/AVX2 equivalence claim."
		},
		{
			"id": "batch::kani_contracts::portable_source_error_contract", "function": "batch::kani_contracts::portable_source_error_contract", "unwind": 33,
			"assertions": ["batch actual scalar source error typed", "batch actual scalar source error consumption", "batch actual source error destination unchanged"], "negative": "batch actual source error destination unchanged",
			"covers": ["batch actual empty success reachable", "batch actual first error reachable"],
			"scope": "0..4 lanes, range 0..20 and immediate EndOfSource; actual scalar sampler, no stubs. No successful nonlinear/AVX2 proof."
